        local function isSelected(name)
            if type(values) == "table" then
                if values[name] == true then return true end
                for _, v in ipairs(values) do if v == name then return true end end
            end
            return false
        end
        for _, t in ipairs({ "Green", "Red", "Yellow", "Scrap" }) do CrateESP.Types[t] = isSelected(t) end

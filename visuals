local WeaponPanel = AimAssistanceTab:CreatePanel("Weapon")
local ab = { Enabled = false, Blocking = false, LastTrigger = 0, BlockCache = {}, Conn = nil }
local function abGetRemote() local ev = repSt:FindFirstChild("Events"); return ev and ev:FindFirstChild("XMHH.2") end
local function abGetTick() local vals = repSt:FindFirstChild("Values"); return vals and vals:FindFirstChild("ServerTick") end
local function abStopBlock(tool)
    local remote = abGetRemote(); local st = abGetTick()
    if remote and st then
        pcall(function() remote:InvokeServer(LPH_ENCSTR("\240\159\141\158"), math.floor(st.Value - 81919), tool, "BZLZSTI2") end)
    end
    ab.Blocking = false
end
local function abStart()
    if ab.Conn then ab.Conn:Disconnect(); ab.Conn = nil end
    ab.Conn = rs2.Heartbeat:Connect(function()
        if not ab.Enabled then return end
        local char = lp2.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool or not hrp then
            if ab.Blocking then abStopBlock(nil) end
            return
        end
        if ab.BlockCache[tool] == nil then
            local can = false
            pcall(function()
                local config = tool:FindFirstChild("Config")
                local cfg = config and require(config)
                if cfg and cfg.BlockSettings and cfg.BlockSettings.Enabled then can = true end
            end)
            if not can and tool:FindFirstChild("AnimsFolder") and tool.AnimsFolder:FindFirstChild("BlockStart") then can = true end
            if tool:GetAttribute("CanBlock") == false then can = false end
            ab.BlockCache[tool] = can
        end
        if not ab.BlockCache[tool] then
            if ab.Blocking then abStopBlock(tool) end
            return
        end
        local shouldBlock = false
        for _, player in ipairs(plrs:GetPlayers()) do
            if player ~= lp2 and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local enemyRoot = player.Character.HumanoidRootPart
                if (enemyRoot.Position - hrp.Position).Magnitude <= 15 then
                    local enemyTool = player.Character:FindFirstChildOfClass("Tool")
                    if enemyTool and not (enemyTool:GetAttribute("Unblockable") or enemyTool:GetAttribute("IgnoreBlock")) then
                        local attacking = false
                        local values = enemyTool:FindFirstChild("Values")
                        if values then
                            if (values:FindFirstChild("Slashing1") and values.Slashing1.Value)
                                or (values:FindFirstChild("Attacking") and values.Attacking.Value) then
                                attacking = true
                            else
                                for _, value in ipairs(values:GetChildren()) do
                                    if value.Name:find("Slashing") and value.Value == true then attacking = true; break end
                                end
                            end
                        end
                        if not attacking then
                            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                            if humanoid then
                                for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                                    local name = track.Name:lower()
                                    if name:find("slash") or name:find("swing") or name:find("attack")
                                        or name:find("lunge") or name:find("heavy") then
                                        attacking = true; break
                                    end
                                end
                            end
                        end
                        if attacking then shouldBlock = true; break end
                    end
                end
            end
        end
        if shouldBlock then
            ab.LastTrigger = tick()
            if not ab.Blocking then
                ab.Blocking = true
                task.spawn(function()
                    local remote = abGetRemote(); local serverTick = abGetTick(); local activeTool = tool
                    while ab.Blocking and ab.Enabled and char and activeTool.Parent == char do
                        if remote and serverTick then
                            pcall(function() remote:InvokeServer(LPH_ENCSTR("\240\159\141\158"), math.floor(serverTick.Value - 81919), activeTool, "BLSTAX1") end)
                        end
                        task.wait(0.1)
                        if tick() - ab.LastTrigger > 0.2 then break end
                    end
                    if ab.Blocking then abStopBlock(activeTool) end
                end)
            end
        elseif ab.Blocking and tick() - ab.LastTrigger > 0.2 then
            abStopBlock(tool)
        end
    end)
end
local function abStop()
    ab.Enabled = false
    if ab.Conn then ab.Conn:Disconnect(); ab.Conn = nil end
    local char = lp2.Character; local tool = char and char:FindFirstChildOfClass("Tool")
    if ab.Blocking then abStopBlock(tool) end
    ab.BlockCache = {}
end
WeaponPanel:CreateToggle({ Text = "Auto Block", Default = false, Flag = "WeaponAutoBlock",
    Callback = function(state) if state then ab.Enabled = true; abStart() else abStop() end end })
WeaponPanel:CreateKeybind({ Text = "Auto Block Bind", Default = Enum.KeyCode.Unknown, Flag = "WeaponAutoBlockBind",
    Callback = function() local cur = Library.Flags["WeaponAutoBlock"]; Library.Elements["WeaponAutoBlock"]:SetValue(not cur) end })

local meleeAura = { Enabled = false, Connection = nil, Range = 20, Cooldown = 0.35, MinHealth = 15, Busy = false, LastSwing = 0 }
meleeAura.PickTarget = function(localHrp, hasEnemies)
    local bestChar, bestDist
    for _, player in ipairs(plrs:GetPlayers()) do
        if player ~= lp2 then
            local status = getPlayerStatus(player)
            local valid = (hasEnemies and status == "Enemy") or (not hasEnemies and status ~= "Friendly")
            if valid then
                local targetChar = player.Character
                local targetHrp  = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                local targetHead = targetChar and targetChar:FindFirstChild("Head")
                local targetHum  = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                if targetHrp and targetHead and targetHum
                    and targetHum.Health > meleeAura.MinHealth
                    and not targetChar:FindFirstChildOfClass("ForceField") then
                    local dist = (localHrp.Position - targetHrp.Position).Magnitude
                    if dist <= meleeAura.Range and (not bestDist or dist < bestDist) then bestChar, bestDist = targetChar, dist end
                end
            end
        end
    end
    return bestChar
end
meleeAura.Swing = function(targetChar)
    local localChar = lp2.Character
    local localHrp  = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local tool      = localChar and localChar:FindFirstChildOfClass("Tool")
    local targetHead = targetChar:FindFirstChild("Head")
    if not (localHrp and tool and targetHead) then return end
    local events = repSt:FindFirstChild("Events")
    local invokeEvent = events and events:FindFirstChild("XMHH.2")
    local fireEvent   = events and events:FindFirstChild("XMHH2.2")
    if not (invokeEvent and fireEvent) then return end
    local ok, invokeResult = pcall(function()
        return invokeEvent:InvokeServer(LPH_ENCSTR("\240\159\141\158"), tick(), tool, "43TRFWX", "Normal", tick(), true)
    end)
    if not ok then return end
    task.wait(0.3)
    if not meleeAura.Enabled then return end
    localChar = lp2.Character; localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
    tool = localChar and localChar:FindFirstChildOfClass("Tool")
    if not (localHrp and tool) then return end
    if not (targetChar.Parent and targetHead.Parent) then return end
    local handle = tool:FindFirstChild("WeaponHandle") or tool:FindFirstChild("Handle") or localChar:FindFirstChild("Right Arm")
    if not handle then return end
    pcall(function()
        fireEvent:FireServer(
            LPH_ENCSTR("\240\159\141\158"), tick(), tool, "2389ZFX34", invokeResult, false,
            handle, targetHead, targetChar, localHrp.Position, targetHead.Position
        )
    end)
end
meleeAura.Disable = function()
    if not meleeAura.Enabled then return end
    meleeAura.Enabled = false; meleeAura.Busy = false
    if meleeAura.Connection then meleeAura.Connection:Disconnect(); meleeAura.Connection = nil end
end
meleeAura.Enable = function()
    if meleeAura.Enabled then return end
    meleeAura.Enabled = true
    meleeAura.Connection = rs2.RenderStepped:Connect(function()
        if not meleeAura.Enabled or meleeAura.Busy then return end
        local now = os.clock()
        if now - meleeAura.LastSwing < meleeAura.Cooldown then return end
        local localChar = lp2.Character
        local localHrp  = localChar and localChar:FindFirstChild("HumanoidRootPart")
        local tool       = localChar and localChar:FindFirstChildOfClass("Tool")
        if not (localHrp and tool) then return end
        local hasEnemies = false
        if Library.PlayerPriorities then
            for _, priority in pairs(Library.PlayerPriorities) do
                if priority == "Enemy" then hasEnemies = true; break end
            end
        end
        local targetChar = meleeAura.PickTarget(localHrp, hasEnemies)
        if not targetChar then return end
        meleeAura.LastSwing = now; meleeAura.Busy = true
        task.spawn(function() pcall(meleeAura.Swing, targetChar); meleeAura.Busy = false end)
    end)
end
WeaponPanel:CreateToggle({ Text = "Melee Aura", Default = false, Flag = "WeaponMeleeAura",
    Callback = function(state) if state then meleeAura.Enable() else meleeAura.Disable() end end })

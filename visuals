-- WORLD ESP (polling interval bumped to 0.5s + skip when nothing enabled)
-- =====================================================
local WorldESP = {
    Dealers = false,
    Cash = false,
    Items = false,
    ATMs = false,
    Highlights = setmetatable({}, { __mode = "k" }),
}

local WorldESPColors = {
    Dealers = Color3.fromRGB(255, 140, 0),
    Cash    = Color3.fromRGB(80, 255, 80),
    Items   = Color3.fromRGB(60, 200, 220),
    ATMs    = Color3.fromRGB(30, 100, 120),
}

local function worldEspApplyHighlight(inst, color, feature)
    if not inst or not inst.Parent then return end
    local entry = WorldESP.Highlights[inst]
    local hl = entry and entry.Highlight
    if not hl or not hl.Parent or (entry and entry.Feature ~= feature) then
        if hl then pcall(function() hl:Destroy() end) end
        hl = Instance.new("Highlight")
        hl.Name = "RAZEBALITI_WorldESP"
        hl.Adornee = inst
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = inst
        WorldESP.Highlights[inst] = { Highlight = hl, Feature = feature }
    else
        hl.FillColor = color
        hl.OutlineColor = color
    end
end

local function worldEspClearFeature(feature)
    for inst, entry in pairs(WorldESP.Highlights) do
        if entry.Feature == feature then
            if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
            WorldESP.Highlights[inst] = nil
        end
    end
end

local function worldEspUpdate()
    local active = {}
    local map = Workspace:FindFirstChild("Map")
    local filter = Workspace:FindFirstChild("Filter")

    local function collect(folder, enabled, color, feature)
        if not enabled or not folder then return end
        for _, inst in ipairs(folder:GetChildren()) do
            if inst.Parent then active[inst] = { Color = color, Feature = feature } end
        end
    end

    collect(map and map:FindFirstChild("Shopz"), WorldESP.Dealers, WorldESPColors.Dealers, "Dealers")
    collect(filter and filter:FindFirstChild("SpawnedBread"), WorldESP.Cash, WorldESPColors.Cash, "Cash")
    collect(filter and filter:FindFirstChild("SpawnedTools"), WorldESP.Items, WorldESPColors.Items, "Items")
    collect(map and map:FindFirstChild("ATMz"), WorldESP.ATMs, WorldESPColors.ATMs, "ATMs")

    local toRemove = {}
    for inst, entry in pairs(WorldESP.Highlights) do
        if not active[inst] or not inst or not inst.Parent then
            toRemove[inst] = true
            if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
        end
    end
    for inst in pairs(toRemove) do WorldESP.Highlights[inst] = nil end

    for inst, info in pairs(active) do
        worldEspApplyHighlight(inst, info.Color, info.Feature)
    end
end

local function worldEspClearAll()
    for inst, entry in pairs(WorldESP.Highlights) do
        if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
    end
    table.clear(WorldESP.Highlights)
end

local lastWorldEspUpdate = 0
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if (now - lastWorldEspUpdate) < 0.5 then return end
    lastWorldEspUpdate = now
    if not (WorldESP.Dealers or WorldESP.Cash or WorldESP.Items or WorldESP.ATMs) and next(WorldESP.Highlights) == nil then
        return
    end
    pcall(worldEspUpdate)
end)

pcall(function()
    if Library.OnUnload then Library:OnUnload(function() worldEspClearAll() end) end
end)

-- =====================================================
-- CRATE ESP
-- =====================================================
local CrateESP = {
    Enabled = false,
    Types = { Green = true, Red = true, Yellow = true, Scrap = true },
    Entries = setmetatable({}, { __mode = "k" }),
    Connections = {},
    PileFolder = nil,
    Generation = 0,
}

local CrateColors = {
    Green  = Color3.fromRGB(80, 255, 80),
    Red    = Color3.fromRGB(255, 80, 80),
    Yellow = Color3.fromRGB(255, 200, 0),
    Scrap  = Color3.fromRGB(180, 180, 180),
}

local function crateGetParticleColor(meshPart)
    if not meshPart then return nil end
    for _, d in ipairs(meshPart:GetDescendants()) do
        if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
            local seq = d.Color
            if seq and seq.Keypoints and #seq.Keypoints > 0 then
                return seq.Keypoints[1].Value
            end
        elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
            if typeof(d.Color) == "Color3" then return d.Color end
        end
    end
    return nil
end

local function crateClassifyModel(model)
    if not model then return nil end
    local meshPart
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("MeshPart") then meshPart = child; break end
    end
    if not meshPart then
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("MeshPart") then meshPart = d; break end
        end
    end
    if not meshPart then return nil end

    local color = crateGetParticleColor(meshPart)
    local name = model.Name
    local crateType

    if name:find("S1", 1, true) then
        crateType = "Scrap"
    elseif name:find("HP", 1, true) then
        crateType = "Yellow"
    elseif name:find("C1", 1, true) then
        if color then
            local h = select(1, Color3.toHSV(color))
            if h >= 0.18 and h <= 0.5 then crateType = "Green" else crateType = "Red" end
        end
    elseif color then
        local h, s, v = Color3.toHSV(color)
        if s < 0.1 or v < 0.1 then crateType = "Scrap"
        elseif h < 0.1 or h > 0.9 then crateType = "Red"
        elseif h >= 0.18 and h <= 0.5 then crateType = "Green"
        elseif h >= 0.05 and h < 0.18 then crateType = "Yellow" end
    end

    if not crateType then return nil end
    if not color then color = CrateColors[crateType] or Color3.fromRGB(255, 255, 255) end
    return { MeshPart = meshPart, Type = crateType, Color = color }
end

local function crateApplyHighlight(model, info)
    local meshPart = info.MeshPart
    if not meshPart or not meshPart.Parent then return end
    local entry = CrateESP.Entries[model]
    local hl = entry and entry.Highlight
    if not hl or not hl.Parent or entry.MeshPart ~= meshPart then
        if hl then pcall(function() hl:Destroy() end) end
        hl = Instance.new("Highlight")
        hl.Name = "RAZEBALITI_CrateESP"
        hl.Adornee = meshPart
        hl.FillColor = info.Color
        hl.OutlineColor = info.Color
        hl.FillTransparency = 0.35
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = meshPart
        CrateESP.Entries[model] = { MeshPart = meshPart, Type = info.Type, Highlight = hl }
    else
        hl.FillColor = info.Color
        hl.OutlineColor = info.Color
        entry.Type = info.Type
    end
end

local function crateRemoveHighlight(model)
    local entry = CrateESP.Entries[model]
    if entry then
        if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
        CrateESP.Entries[model] = nil
    end
end

local function crateClearAll()
    for model, entry in pairs(CrateESP.Entries) do
        if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
    end
    table.clear(CrateESP.Entries)
end

local function crateTryModel(model, gen)
    if not CrateESP.Enabled or CrateESP.Generation ~= gen then return false end
    if not model or not model.Parent then return false end
    local info = crateClassifyModel(model)
    if not info then return false end
    if CrateESP.Types[info.Type] then crateApplyHighlight(model, info) else crateRemoveHighlight(model) end
    return true
end

local crateRetryDelays = { 0.05, 0.15, 0.35, 0.75, 1.5 }

local function crateScheduleModel(model, gen, idx)
    if not model or not model.Parent then return end
    if not CrateESP.Enabled or CrateESP.Generation ~= gen then return end
    idx = idx or 1
    local d = crateRetryDelays[idx]
    if not d then return end
    task.delay(d, function()
        if not CrateESP.Enabled or CrateESP.Generation ~= gen then return end
        if not model or not model.Parent then return end
        if not crateTryModel(model, gen) then crateScheduleModel(model, gen, idx + 1) end
    end)
end

local function crateRefreshAll()
    if not CrateESP.PileFolder then return end
    local gen = CrateESP.Generation
    for _, model in ipairs(CrateESP.PileFolder:GetChildren()) do
        crateTryModel(model, gen)
        task.delay(0.2, function()
            if CrateESP.Enabled and CrateESP.Generation == gen and model.Parent then
                crateTryModel(model, gen)
            end
        end)
    end
end

local function crateSetupConnections()
    for _, conn in ipairs(CrateESP.Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(CrateESP.Connections)
    local filter = Workspace:FindFirstChild("Filter")
    local piles = filter and filter:FindFirstChild("SpawnedPiles")
    CrateESP.PileFolder = piles
    if not piles then return false end
    local gen = CrateESP.Generation
    table.insert(CrateESP.Connections, piles.ChildAdded:Connect(function(model)
        if not CrateESP.Enabled or CrateESP.Generation ~= gen then return end
        crateScheduleModel(model, gen, 1)
    end))
    table.insert(CrateESP.Connections, piles.ChildRemoved:Connect(function(model)
        crateRemoveHighlight(model)
    end))
    crateRefreshAll()
    return true
end

local function crateEnable()
    CrateESP.Enabled = true
    CrateESP.Generation += 1
    local gen = CrateESP.Generation
    local filter = Workspace:FindFirstChild("Filter")
    if not (filter and filter:FindFirstChild("SpawnedPiles")) then
        if filter then
            local waitConn
            waitConn = filter.ChildAdded:Connect(function(child)
                if child.Name == "SpawnedPiles" and CrateESP.Enabled and CrateESP.Generation == gen then
                    pcall(function() waitConn:Disconnect() end)
                    crateSetupConnections()
                end
            end)
            table.insert(CrateESP.Connections, waitConn)
        end
        task.delay(1, function()
            if CrateESP.Enabled and CrateESP.Generation == gen and not CrateESP.PileFolder then
                crateSetupConnections()
            end
        end)
        return
    end
    crateSetupConnections()
end

local function crateDisable()
    CrateESP.Enabled = false
    CrateESP.Generation += 1
    crateClearAll()
    for _, conn in ipairs(CrateESP.Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(CrateESP.Connections)
    CrateESP.PileFolder = nil
end


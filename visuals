                    wr += partWeights[pidx]
                    if pidx == partCount then budgetCap = methodBudget
                    else
                        local es = pidx / partCount
                        local ws = wr / weightTotal
                        local share = es + (ws - es) * bias
                        budgetCap = math.clamp(math.floor(methodBudget * share + 0.5), pidx, methodBudget)
                    end
                    local hits = getMethodPositions(methodName, part.Position + lead, localRoot.Position, hitRadius, hitScans)
                    local oc = #origins; local pt = #hits * oc
                    if pt > 0 then
                        local ck = methodName .. part.Name
                        local cs = getCursor(targetCharacter, ck, pt)
                        local walked = 0
                        fallback.Part = part; fallback.Method = methodName
                        while walked < pt do
                            local linear = (cs + walked) % pt
                            local hp = hits[math.floor(linear / oc) + 1]
                            local op = origins[linear % oc + 1]
                            walked += 1
                            local clear, exhausted = tryMethod(op, hp, true)
                            if clear then
                                setCursor(targetCharacter, ck, linear)
                                scoreMethod(targetCharacter, methodName, true)
                                return op, hp, part, methodName
                            end
                            if exhausted then break end
                        end
                        setCursor(targetCharacter, ck, (cs + walked) % pt)
                        fallback.Part = nil
                    end
                    if methodUsed >= methodBudget then break end
                end
            end
            if methodUsed > 0 then scoreMethod(targetCharacter, methodName, false) end
        end
        return nil, nil, nil, nil, fallback
    end
    local function computePath(localRoot, targetCharacter)
        local priorityParts, partWeights = getPriorityParts(targetCharacter)
        if #priorityParts == 0 then return nil end
        local base = { cam2, lp2.Character, targetCharacter }
        local scratch = {}
        for i, inst in ipairs(base) do scratch[i] = inst end
        rayBudget.Base = base; rayBudget.ServerScratch = scratch
        rayParams.FilterDescendantsInstances = base
        serverRayParams.FilterDescendantsInstances = scratch
        local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
        slackLimit = 0
        if ragebotFlags.hit_Slack then
            local slack = math.max(0, tonumber(ragebotFlags.hit_Slack_Range) or 25)
            if ragebotFlags.hit_Slack_Velocity and targetRoot then slack += targetRoot.AssemblyLinearVelocity.Magnitude end
            slackLimit = slack
        end
        leadOffset = getLead(targetCharacter)
        local scan = rayBudget.Scan
        if scan then scan.Base = base; scan.Scratch = scratch; scan.Slack = slackLimit; scan.Lead = leadOffset end
        local wallEnabled = ragebotFlags.wall_Bang == true
        local wallLimit = math.max(0.1, tonumber(ragebotFlags.wall_Thickness) or 4)
        local wallCount = math.max(1, math.floor(tonumber(ragebotFlags.wall_Count) or 1))
        local store = lastGood[targetCharacter]
        if store then
            local i = 1
            while i <= #store do
                local entry = store[i]
                local ep = entry.Part
                if not ep or not ep.Parent or not table.find(priorityParts, ep) or (entry.Wall and not wallEnabled) then
                    table.remove(store, i)
                else
                    pace()
                    local so = localRoot.Position + entry.OriginOffset
                    local sh = ep.Position + leadOffset + entry.HitOffset
                    local passed
                    if entry.Wall then
                        local th, wl, mat, bn = measureBlock(so, sh, wallCount)
                        rayBudget.Left -= wl * 2 + 1
                        local limit, learned = wallLimit, false
                        if wallLearnLimit then limit, learned = wallLearnLimit(mat and mat.Name or nil, bn, wallLimit) end
                        passed = wl > 0 and th <= limit
                        if passed then
                            wallInfo.Thickness = th; wallInfo.Walls = wl
                            wallInfo.Material = mat and mat.Name or "Unknown"
                            wallInfo.Name = bn or "Unknown"; wallInfo.Learned = learned
                        end
                    else
                        rayBudget.Left -= 1
                        passed = isPathClear(so, sh, true)
                    end
                    if passed then
                        entry.Fails = 0
                        if i > 1 then table.remove(store, i); table.insert(store, 1, entry) end
                        return so, sh, ep, entry.Method, true, false, entry.Wall == true
                    end
                    entry.Fails = (entry.Fails or 0) + 1
                    if entry.Fails >= seedFailLimit then table.remove(store, i) else i += 1 end
                end
            end
            if #store == 0 then lastGood[targetCharacter] = nil end
        end
        local history = ragebotFlags.shot_Cache and shotCache[targetCharacter] or nil
        if history then
            local tol = math.max(0, tonumber(ragebotFlags.shot_Cache_Tolerance) or 0.6)
            local ol = math.clamp(tonumber(ragebotFlags.path_Origin_Shift_Range) or 19, 0.1, 19.5) + tol
            local hl = getHitRadius() + tol
            local i = 1
            while i <= #history do
                local entry = history[i]
                local ep = entry.Part
                if not ep or not ep.Parent or not table.find(priorityParts, ep) then
                    table.remove(history, i)
                else
                    pace()
                    local aim = ep.Position + leadOffset
                    if rayBudget.Left > 0
                        and (localRoot.Position - entry.Origin).Magnitude <= ol
                        and (aim - entry.Goal).Magnitude <= hl then
                        rayBudget.Left -= 1
                        if isPathClear(entry.Origin, entry.Goal, true) then
                            return entry.Origin, entry.Goal, ep, entry.Method, true, false, false
                        end
                    end
                    i += 1
                end
            end
            if #history == 0 then shotCache[targetCharacter] = nil end
        end
        if rayBudget.Left <= 0 then return nil, nil, nil, nil, false, true end
        local sp, hp, hpt, method, fallback = searchPath(localRoot, targetCharacter, priorityParts, partWeights,
            store and store[1] and store[1].Method)
        local throughWall = false
        if not sp and wallEnabled and fallback and fallback.BestPart and fallback.BestPart.Parent then
            pace()
            local th, wl, mat, bn = measureBlock(fallback.From, fallback.To, wallCount)
            rayBudget.Left -= wl * 2 + 1
            local limit, learned = wallLimit, false
            if wallLearnLimit then limit, learned = wallLearnLimit(mat and mat.Name or nil, bn, wallLimit) end
            if wl > 0 and th <= limit then
                sp = fallback.From; hp = fallback.To; hpt = fallback.BestPart
                method = fallback.BestMethod; throughWall = true
                wallInfo.Thickness = th; wallInfo.Walls = wl
                wallInfo.Material = mat and mat.Name or "Unknown"
                wallInfo.Name = bn or "Unknown"; wallInfo.Learned = learned
            end
        end
        if sp then
            rememberLine(targetCharacter, {
                OriginOffset = sp - localRoot.Position,
                HitOffset = hp - (hpt.Position + leadOffset),
                Part = hpt, Method = method, Wall = throughWall, Fails = 0, Shots = 0,
            })
            if ragebotFlags.shot_Cache and not throughWall then
                local h = shotCache[targetCharacter]
                if not h then h = {}; shotCache[targetCharacter] = h end
                table.insert(h, 1, { Origin = sp, Goal = hp, Part = hpt, Method = method })
                local size = math.max(1, math.floor(tonumber(ragebotFlags.shot_Cache_Size) or 5))
                for i = #h, size + 1, -1 do h[i] = nil end
            end
        end
        return sp, hp, hpt, method, false, false, throughWall
    end
    local function findPath(localRoot, targetCharacter)
        local now = os.clock()
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return nil end
        local cached = pathCache[targetCharacter]
        local interval = getScanInterval()
        if (now - rayBudget.Time) >= interval then
            rayBudget.Time = now
            rayBudget.Left = math.max(1, math.floor(tonumber(ragebotFlags.path_Ray_Budget) or 1500))
        end
        if cached and (now - cached.Time) < interval then
            if not cached.Found then return nil end
            if not cached.HitPart or not cached.HitPart.Parent then return nil end
            local ld = localRoot.Position - cached.LocalPosition
            local td = targetRoot.Position - cached.TargetPosition
            if ld.Magnitude > cacheDriftLimit or td.Magnitude > cacheDriftLimit then return nil end
            return cached.ShootPosition + ld, cached.HitPosition + td, cached.HitPart, cached.Method, true, cached.Wall
        end
        local scans = rayBudget.Scans
        local scan = scans[targetCharacter]
        if scan and (scan.Root ~= localRoot or now - scan.Time > 0.25) then scans[targetCharacter] = nil; scan = nil end
        if now > rayBudget.Deadline then return nil end
        if not scan then scan = { Root = localRoot, Thread = coroutine.create(computePath) }; scans[targetCharacter] = scan end
        scan.Time = now
        rayBudget.Scan = scan
        if scan.Base and rayBudget.Last ~= scan then
            rayBudget.Base = scan.Base; rayBudget.ServerScratch = scan.Scratch
            rayParams.FilterDescendantsInstances = scan.Base
            serverRayParams.FilterDescendantsInstances = scan.Scratch
            slackLimit = scan.Slack; leadOffset = scan.Lead
        end
        rayBudget.Last = scan
        local ok, sp, hp, hpt, method, fromSeed, starved, throughWall = coroutine.resume(scan.Thread, localRoot, targetCharacter)
        rayBudget.Scan = nil
        if coroutine.status(scan.Thread) ~= "dead" then return nil end
        if scans[targetCharacter] == scan then scans[targetCharacter] = nil end
        if not ok or starved then return nil end
        pathCache[targetCharacter] = {
            Time = now, LocalPosition = localRoot.Position, TargetPosition = targetRoot.Position,
            Found = sp ~= nil, ShootPosition = sp, HitPosition = hp,
            HitPart = hpt, Method = method, Wall = throughWall,
        }
        return sp, hp, hpt, method, fromSeed, throughWall
    end
    return {
        ClearCache = clearCache, Find = findPath, NoteShot = noteShot,
        Frame = function()
            local now = os.clock()
            local limit = math.clamp(tonumber(ragebotFlags.path_Frame_Time) or 4, 1, 16)
            rayBudget.Deadline = now + limit / 1000
            for target, scan in pairs(rayBudget.Scans) do
                if now - scan.Time > 0.25 then rayBudget.Scans[target] = nil end
            end
        end,
        Lead = getLead, HitRadius = getHitRadius, Parts = getPriorityParts,
        Bones = boneOrder, WallInfo = wallInfo,
    }
end)()

local rageSurfaceSides = { "Front", "Back", "Left", "Right", "Top", "Bottom" }
local function buildRageSurface(hitPart, hitPosition, shootPosition)
    if ragebotFlags.surface_mode == "None" then return nil end
    if ragebotFlags.surface_mode ~= "Direct" then
        return {
            rageSurfaceSides[math.random(1, 6)],
            UDim2.new(math.random() * 0.9 + 0.05, -3, math.random() * 0.9 + 0.05, -3),
            Vector2.new(10, 20),
        }
    end
    local delta = hitPosition - shootPosition
    if delta.Magnitude <= 1e-6 then delta = Vector3.new(0, 0, -1) end
    local frame = hitPart.CFrame
    local dir = frame:VectorToObjectSpace(delta.Unit)
    local size = hitPart.Size
    local half = size * 0.5
    local point = frame:PointToObjectSpace(hitPosition)
    local ax, ay, az = math.abs(dir.X), math.abs(dir.Y), math.abs(dir.Z)
    local side, u, v
    if az >= ax and az >= ay then
        side = dir.Z > 0 and "Front" or "Back"
        u = (point.X + half.X) / size.X; v = (half.Y - point.Y) / size.Y
    elseif ax >= ay then
        side = dir.X > 0 and "Left" or "Right"
        u = (point.Z + half.Z) / size.Z; v = (half.Y - point.Y) / size.Y
    else
        side = dir.Y > 0 and "Bottom" or "Top"
        u = (point.X + half.X) / size.X; v = (point.Z + half.Z) / size.Z
    end
    return {
        side, UDim2.new(math.clamp(u, 0, 1), -3, math.clamp(v, 0, 1), -3),
        Vector2.new(10, 20),
    }
end
local function pingRageShotCheck(tool)
    if not rageSilentAimCheck then return end
    local values = repSt:FindFirstChild("Values")
    local serverTick = values and values:FindFirstChild("ServerTick")
    if not serverTick then return end
    local payload = {}
    for _ = 1, math.random(2, 5) do
        payload[string.format("%x", math.random(256, 4095))] = math.random() * 2 - 1
    end
    pcall(rageSilentAimCheck.FireServer, rageSilentAimCheck, tool, serverTick.Value * 2 - 91873, payload)
end
local function fireRageShot()
    if not RAGE_READY then return end
    local localCharacter = lp2.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    local tool = localCharacter and localCharacter:FindFirstChildOfClass("Tool")
    if not localRoot or not tool then return end
    local values = tool:FindFirstChild("Values")
    local hitmarker = tool:FindFirstChild("Hitmarker")
    local serverAmmo = values and values:FindFirstChild("SERVER_Ammo")
    local storedAmmo = values and values:FindFirstChild("SERVER_StoredAmmo")
    local clientAmmo = values and values:FindFirstChild("Ammo")
    local clientStored = values and values:FindFirstChild("StoredAmmo")
    if not serverAmmo or not storedAmmo then return end
    local magNow = clientAmmo and clientAmmo.Value or serverAmmo.Value
    local reserveNow = clientStored and clientStored.Value or storedAmmo.Value
    if magNow <= 0 then
        if reserveNow > 0 and tool.Parent and not ragebotController.Unloaded then rageProto.Reload(tool) end
        return
    end
    local gap = rageProto.FireGap(tool)
    if gap > 0 and (os.clock() - ragebotController.LastFire) < gap then return end
    local shellInfo = rageProto.Info(tool)
    if shellInfo and shellInfo.ShellReload and shellInfo.MagSize > 0 and magNow < shellInfo.MagSize and reserveNow > 0 then
        rageProto.Reload(tool)
    end
    local targets = getSortedRageTargets()
    if #targets == 0 then return end
    ragePathFinding.Frame()
    local targetCharacter, shootPosition, hitPosition, hitPart, pathMethod, pathCached, pathWall
    for _, target in ipairs(targets) do
        local character = target.Character
        if character and (not ragebotFlags.check_ForceField or not character:FindFirstChildOfClass("ForceField")) then
            shootPosition, hitPosition, hitPart, pathMethod, pathCached, pathWall =
                ragePathFinding.Find(localRoot, character)
            if shootPosition then
                targetCharacter = character
                if getPlayerStatus(target.Player) == "Enemy" then ragebotFlags.locked_Target = target.Player end
                break
            end
        end
    end
    if not shootPosition then return end
    if not targetCharacter or (ragebotFlags.check_ForceField and targetCharacter:FindFirstChildOfClass("ForceField")) then return end
    local rageTargetPlayer = plrs:GetPlayerFromCharacter(targetCharacter)
    if rageTargetPlayer then
        ragebotController.LastShotTarget = rageTargetPlayer
        ragebotController.LastShotTargetCharacter = targetCharacter
        ragebotController.LastShotTargetTime = os.clock()
        ragebotController.StickyTarget = rageTargetPlayer
    end
    local delta = hitPosition - shootPosition
    if delta.Magnitude <= 0.0001 then return end
    local direction = delta.Unit
    local hitOffset = hitPosition - (hitPart.Position + ragePathFinding.Lead(targetCharacter))
    local shotId = rageProto.ShotId()
    ragebotController.ShotInProgress = true
    getgenv().drain_rage_shooting = true
    ragebotController.LastFire = os.clock()
    rageStartShootEvent:FireServer(rageProto.SecurityCode(), shotId, tool, rageShotToken, shootPosition, { direction }, false, nil)
    local fireRate = math.clamp(tonumber(ragebotFlags.fire_Rate) or 50, 0, 100)
    task.wait((1 - fireRate / 100) * 0.2)
    local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    local aborted = ragebotController.Unloaded or not ragebotFlags.enabled
        or lp2.Character ~= localCharacter or tool.Parent == nil
        or hitPart == nil or hitPart.Parent == nil or targetCharacter.Parent == nil
        or (targetHumanoid ~= nil and targetHumanoid.Health <= 0)
    if not aborted then
        local healthBefore = targetHumanoid and targetHumanoid.Health or 0
        local hitLimit = ragePathFinding.HitRadius()
        if hitOffset.Magnitude > hitLimit then hitOffset = hitOffset.Unit * hitLimit end
        local finalHit = hitPart.Position + ragePathFinding.Lead(targetCharacter) + hitOffset
        local finalDelta = finalHit - shootPosition
        if finalDelta.Magnitude > 0.0001 then
            hitPosition = finalHit
            direction = finalDelta.Unit
        end
        rageFinishShootEvent:FireServer(
            rageHitMarker, tool, shotId, 1, hitPart, hitPosition, direction,
            nil, buildRageSurface(hitPart, hitPosition, shootPosition), nil, nil
        )
        if rageTargetPlayer and targetHumanoid then
            trackRageHit(rageTargetPlayer, targetCharacter, targetHumanoid, pathMethod, healthBefore)
        end
        pingRageShotCheck(tool)
        ragePathFinding.NoteShot(targetCharacter)
        if clientAmmo and clientAmmo.Parent then clientAmmo.Value = math.max(clientAmmo.Value - 1, 0) end
        if clientStored and clientStored.Parent and storedAmmo.Parent then clientStored.Value = storedAmmo.Value end
        if ragebotFlags.show_Hitmarker and hitmarker and hitmarker.Parent and hitmarker:IsA("BindableEvent") then
            hitmarker:Fire(hitPart)
        end
    end
    ragebotController.ShotInProgress = false
    getgenv().drain_rage_shooting = false
end

task.spawn(function()
    while not ragebotController.Unloaded do
        if ragebotFlags.enabled and RAGE_READY then
            pcall(fireRageShot)
            ragebotController.ShotInProgress = false
            getgenv().drain_rage_shooting = false
        end
        rs2.RenderStepped:Wait()
    end
end)


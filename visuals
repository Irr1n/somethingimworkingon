rageProto.UnknownGap = 0.125
rageProto.Configs = setmetatable({}, { __mode = "k" })
rageProto.Info = function(tool)
    local cached = rageProto.Configs[tool]
    if cached ~= nil then return cached end
    local info = false
    local module = tool:FindFirstChild("Config")
    if module and module:IsA("ModuleScript") then
        local ok, config = pcall(require, module)
        if ok and type(config) == "table" then
            local rate = tonumber(config.FireRate) or 0
            local modes = config.FireModeSettings
            if type(modes) == "table" and modes.CanSwitch then
                if modes.SwitchTo == "Burst" then rate = tonumber(modes.BurstRate) or rate end
                local semi = tonumber(modes.SemiRate)
                if semi and semi > rate then rate = semi end
            end
            local shotgun = config.ShotgunSettings
            local shell = type(shotgun) == "table"
            info = {
                Rate = rate, MagSize = tonumber(config.MagSize) or 0,
                ReloadTime = tonumber(config.ReloadTime) or 2,
                ShellReload = shell and shotgun.ShotgunReload == true,
                ShellTime = math.max(shell and tonumber(shotgun.ShellInTime) or 0, 0.25),
            }
        end
    end
    rageProto.Configs[tool] = info
    return info
end
rageProto.Rate = function(tool)
    local info = rageProto.Info(tool)
    if info and info.Rate > 0 then return info.Rate end
    return rageWeaponFireRates[tool.Name] or 0
end
rageProto.FireGap = function(tool)
    local rate = rageProto.Rate(tool)
    if rate <= 0 then return rageProto.UnknownGap end
    if ragebotFlags.fire_Rate_Per_Weapon then return 1 / rate end
    return math.max(1 / rate - 0.04, 0)
end

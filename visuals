end
local function espDrawLine(frame, x1, y1, x2, y2, thickness)
    local dx, dy = x2 - x1, y2 - y1
    local dist = math.sqrt(dx * dx + dy * dy)
    local angle = math.deg(math.atan2(dy, dx))
    frame.Position = UDim2.new(0, math.floor(x1), 0, math.floor(y1 - thickness / 2))
    frame.Size = UDim2.new(0, math.floor(dist), 0, thickness)
    frame.Rotation = angle
end

local function chamsApplyToCharacter(char, color, onTop, transparency)
    if not char or not char.Parent then return end
    local state = chamsState[char]
    if state and state.Color == color and state.OnTop == onTop and state.Transparency == transparency then
        return
    end
    chamsState[char] = { Color = color, OnTop = onTop, Transparency = transparency }
    local hl = char:FindFirstChild("RAZEBALITI_ESP_Highlight")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "RAZEBALITI_ESP_Highlight"
        hl.Adornee = char
        hl.Parent = char
    end
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = transparency
    hl.OutlineTransparency = 0
    hl.Enabled = true
    pcall(function() hl.RespectCanCollide = false end)
    if onTop then
        local ok = pcall(function() hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
        if not ok then pcall(function() hl.DepthMode = "AlwaysOnTop" end) end
    else
        pcall(function() hl.DepthMode = Enum.HighlightDepthMode.Occluded end)
    end
    if onTop then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local box = part:FindFirstChild("RAZEBALITI_ChamsBox")
                if not box then
                    box = Instance.new("BoxHandleAdornment")
                    box.Name = "RAZEBALITI_ChamsBox"
                    box.Adornee = part
                    box.Size = part.Size
                    box.AlwaysOnTop = true
                    box.ZIndex = 5
                    box.Parent = part
                end
                pcall(function()
                    box.Color3 = color
                    box.Transparency = math.clamp(transparency, 0.1, 0.9)
                end)
            end
        end
    else
        for _, d in ipairs(char:GetDescendants()) do
            if d.Name == "RAZEBALITI_ChamsBox" then pcall(function() d:Destroy() end) end
        end
    end
end

local function chamsRemoveFromCharacter(char)
    if not char then return end

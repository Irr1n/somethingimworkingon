local GunAdjustPanel = MiscTab:CreatePanel("Gun Adjustment")
local gunAdj = {
    Enabled = false,
    Mode = "Remove Recoil & Spread",
    ReducePct = 100,
    weapons = setmetatable({}, { __mode = "k" }),
    originals = setmetatable({}, { __mode = "k" }),
    knownToolNames = {},
    connections = {},
    ScanGeneration = 0,
    CacheInitialized = false,
    MaintenanceRunning = false,
}

local function gunAdjRegisterWeapon(tbl)
    if type(tbl) ~= "table" then return false end
    if gunAdj.weapons[tbl] then return false end
    local hasRecoil = rawget(tbl, "Recoil") ~= nil
    local hasSpread = rawget(tbl, "Spread") ~= nil
    local hasAngle = rawget(tbl, "AngleX_Min") ~= nil or rawget(tbl, "AngleX_Max") ~= nil
    local hasRecoilEnabled = rawget(tbl, "CameraRecoilingEnabled") ~= nil
    if not (hasRecoil or hasSpread or hasAngle or hasRecoilEnabled) then return false end
    gunAdj.weapons[tbl] = true
    gunAdj.originals[tbl] = {
        Recoil = rawget(tbl, "Recoil"),
        CameraRecoilingEnabled = rawget(tbl, "CameraRecoilingEnabled"),
        AngleX_Min = rawget(tbl, "AngleX_Min"),
        AngleX_Max = rawget(tbl, "AngleX_Max"),
        AngleY_Min = rawget(tbl, "AngleY_Min"),
        AngleY_Max = rawget(tbl, "AngleY_Max"),
        AngleZ_Min = rawget(tbl, "AngleZ_Min"),
        AngleZ_Max = rawget(tbl, "AngleZ_Max"),
        Spread = rawget(tbl, "Spread"),
    }
    return true
end

local function gunAdjScanGCOnce(generation)
    if type(getgc) ~= "function" then return false end
    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then return false end
    local processed = 0
    for _, value in pairs(objects) do
        if generation ~= gunAdj.ScanGeneration or not gunAdj.Enabled then return false end
        gunAdjRegisterWeapon(value)
        processed += 1
        if processed % 500 == 0 then task.wait() end
    end
    return true
end

local function gunAdjScanCurrentTools()
    if not gunAdj.Enabled then return end
    local containers = {}
    local char = LocalPlayer.Character
    if char then table.insert(containers, char) end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then table.insert(containers, backpack) end
    for _, container in ipairs(containers) do
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local cfgModule = tool:FindFirstChild("Config")
                if cfgModule and cfgModule:IsA("ModuleScript") then
                    local ok, cfg = pcall(require, cfgModule)
                    if ok then gunAdjRegisterWeapon(cfg) end
                end
            end
        end
    end
end

local function gunAdjApply()
    if not gunAdj.Enabled then return end
    for w in pairs(gunAdj.weapons) do
        pcall(function()
            if gunAdj.Mode == "Remove Recoil & Spread" then
                w.Recoil = 0
                w.CameraRecoilingEnabled = false
                w.AngleX_Min = 0; w.AngleX_Max = 0
                w.AngleY_Min = 0; w.AngleY_Max = 0
                w.AngleZ_Min = 0; w.AngleZ_Max = 0
                w.Spread = 0
            elseif gunAdj.Mode == "Reduce Recoil" then
                local orig = gunAdj.originals[w]
                if orig then
                    local mult = (100 - gunAdj.ReducePct) / 100
                    if orig.Recoil ~= nil then w.Recoil = orig.Recoil * mult end
                    if orig.Spread ~= nil then w.Spread = orig.Spread * mult end
                    if orig.AngleX_Min ~= nil then w.AngleX_Min = orig.AngleX_Min * mult end
                    if orig.AngleX_Max ~= nil then w.AngleX_Max = orig.AngleX_Max * mult end
                    if orig.AngleY_Min ~= nil then w.AngleY_Min = orig.AngleY_Min * mult end
                    if orig.AngleY_Max ~= nil then w.AngleY_Max = orig.AngleY_Max * mult end
                    if orig.AngleZ_Min ~= nil then w.AngleZ_Min = orig.AngleZ_Min * mult end
                    if orig.AngleZ_Max ~= nil then w.AngleZ_Max = orig.AngleZ_Max * mult end
                    w.CameraRecoilingEnabled = mult > 0.01
                end
            end
        end)
    end
end

local function gunAdjRestore()
    for w, orig in pairs(gunAdj.originals) do
        pcall(function()
            if orig.Recoil ~= nil then w.Recoil = orig.Recoil end
            if orig.CameraRecoilingEnabled ~= nil then w.CameraRecoilingEnabled = orig.CameraRecoilingEnabled end
            if orig.AngleX_Min ~= nil then w.AngleX_Min = orig.AngleX_Min end
            if orig.AngleX_Max ~= nil then w.AngleX_Max = orig.AngleX_Max end
            if orig.AngleY_Min ~= nil then w.AngleY_Min = orig.AngleY_Min end
            if orig.AngleY_Max ~= nil then w.AngleY_Max = orig.AngleY_Max end
            if orig.AngleZ_Min ~= nil then w.AngleZ_Min = orig.AngleZ_Min end
            if orig.AngleZ_Max ~= nil then w.AngleZ_Max = orig.AngleZ_Max end
            if orig.Spread ~= nil then w.Spread = orig.Spread end
        end)
    end
end

local function gunAdjRecordToolName(tool)
    if not tool:IsA("Tool") then return false end
    if gunAdj.knownToolNames[tool.Name] then return false end
    gunAdj.knownToolNames[tool.Name] = true
    return true
end

local function gunAdjHandleTool(tool)
    if not tool:IsA("Tool") then return end
    gunAdjRecordToolName(tool)
    if not gunAdj.Enabled then return end
    task.delay(0.1, function()
        if not gunAdj.Enabled or not tool.Parent then return end
        local cfgModule = tool:FindFirstChild("Config")
        if cfgModule and cfgModule:IsA("ModuleScript") then
            local ok, cfg = pcall(require, cfgModule)
            if ok then
                gunAdjRegisterWeapon(cfg)
                gunAdjApply()
            end
        end
    end)
end

local function startGunAdjMaintenanceLoop()
    if gunAdj.MaintenanceRunning then return end
    gunAdj.MaintenanceRunning = true
    task.spawn(function()
        local lastToolScan = os.clock()
        while gunAdj.Enabled do
            task.wait(0.35)
            if not gunAdj.Enabled then break end
            pcall(gunAdjApply)
            local now = os.clock()
            if (now - lastToolScan) >= 2 then
                lastToolScan = now
                pcall(gunAdjScanCurrentTools)
                pcall(gunAdjApply)
            end
        end
        gunAdj.MaintenanceRunning = false
    end)
end

local function gunAdjInitialEnable()
    gunAdj.ScanGeneration += 1
    local gen = gunAdj.ScanGeneration
    gunAdjScanCurrentTools()
    gunAdjApply()
    task.spawn(function()
        if not gunAdj.Enabled or gen ~= gunAdj.ScanGeneration then return end
        gunAdjScanGCOnce(gen)
        if gunAdj.Enabled and gen == gunAdj.ScanGeneration then
            gunAdj.CacheInitialized = true
            gunAdjApply()
        end
    end)
    startGunAdjMaintenanceLoop()
end

local function gunAdjHookChar(ch)
    if not ch then return end
    for _, c in ipairs(ch:GetChildren()) do
        if c:IsA("Tool") then gunAdjRecordToolName(c) end
    end
    table.insert(gunAdj.connections, ch.ChildAdded:Connect(gunAdjHandleTool))
    if gunAdj.Enabled then
        task.delay(0.15, function()
            if not gunAdj.Enabled then return end
            gunAdjScanCurrentTools()
            gunAdjApply()
        end)
        startGunAdjMaintenanceLoop()
    end
end

local function gunAdjHookBackpack(bp)
    if not bp then return end
    table.insert(gunAdj.connections, bp.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and gunAdj.Enabled then gunAdjHandleTool(child) end
    end))
end


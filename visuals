    if not cam then return end
    local viewport = cam.ViewportSize
    local localChar = lp2.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local localPos = localRoot and localRoot.Position or cam.CFrame.Position
    local cfg = PlayerESP.Cfg
    for _, player in ipairs(Players:GetPlayers()) do
        if player == lp2 and not cfg.IncludeLocal then espDestroyObjects(player); continue end
        local char = player.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local valid = char and humanoid and hrp and head and humanoid.Health > 0
        if cfg.OnlyEnemies and valid then if getPlayerStatus(player) ~= "Enemy" then valid = false end end
        if not valid then
            local o = PlayerESP.Objects[player]
            if o and o.Container then o.Container.Visible = false end
            if cfg.Chams and char then chamsRemoveFromCharacter(char) end
            continue
        end
        local worldDist = (hrp.Position - localPos).Magnitude
        if cfg.RenderDistance > 0 and worldDist > cfg.RenderDistance then
            local o = PlayerESP.Objects[player]
            if o and o.Container then o.Container.Visible = false end
            if cfg.Chams and char then chamsRemoveFromCharacter(char) end
            continue
        end
        local headWorld = head.Position + Vector3.new(0, head.Size.Y * 0.5, 0)
        local feetWorld = hrp.Position - Vector3.new(0, hrp.Size.Y * 0.5, 0)
        local headScreen, headVis = cam:WorldToViewportPoint(headWorld)
        local feetScreen, feetVis = cam:WorldToViewportPoint(feetWorld)
        local onScreen = headVis and feetVis and headScreen.Z > 0 and feetScreen.Z > 0

        if cfg.Chams then
            local chamsColor = espIsFriend(player) and cfg.FriendsColor or cfg.ChamsColor
            chamsApplyToCharacter(char, chamsColor, cfg.ChamsOnTop, cfg.ChamsTransparency)
        elseif char then
            chamsRemoveFromCharacter(char)

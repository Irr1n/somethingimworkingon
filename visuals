    if worldEffects.Fullbright.Active then return end
    worldEffects.Fullbright.Active = true
    worldEffects.Fullbright.PostEffects = {}
    worldSet("ClockTime", 14)
    worldSet("Brightness", 5)
    worldSet("GlobalShadows", false)
    applyWorldAmbient()
    for _, effect in ipairs(LightingService:GetChildren()) do
        if effect:IsA("PostEffect") then
            worldEffects.Fullbright.PostEffects[effect] = effect.Enabled
            pcall(function() effect.Enabled = false end)
        end
    end
    worldConn("fb_clock", "ClockTime", function() if worldEffects.Fullbright.Enabled then worldSet("ClockTime", 14) end end)
    worldConn("fb_brightness", "Brightness", function() if worldEffects.Fullbright.Enabled then worldSet("Brightness", 5) end end)
    worldConn("fb_shadows", "GlobalShadows", function() if worldEffects.Fullbright.Enabled then worldSet("GlobalShadows", false) end end)
    worldConn("fb_ambient", "Ambient", function() if worldEffects.Fullbright.Enabled then applyWorldAmbient() end end)
end

local function fullbrightDisable()
    worldDisconn("fb_clock"); worldDisconn("fb_brightness")
    worldDisconn("fb_shadows"); worldDisconn("fb_ambient")
    if not worldEffects.Fullbright.Active then return end
    worldEffects.Fullbright.Active = false
    worldSet("ClockTime", worldOrig.ClockTime)
    worldSet("Brightness", worldOrig.Brightness)
    worldSet("GlobalShadows", worldEffects.NoShadows.Enabled and false or worldOrig.GlobalShadows)
    applyWorldAmbient()
    for effect, wasEnabled in pairs(worldEffects.Fullbright.PostEffects) do
        if effect and effect.Parent then
            pcall(function() effect.Enabled = wasEnabled end)
        end
    end
    worldEffects.Fullbright.PostEffects = {}
end


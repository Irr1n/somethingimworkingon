rageProto.ReloadSpan = function(info)
    local span = (info and tonumber(info.ReloadTime)) or 2
    local stats = repSt:FindFirstChild("CharStats")
    stats = stats and stats:FindFirstChild(lp2.Name)
    if not stats then return span end
    local health = stats:FindFirstChild("HealthValues")
    if health then
        for _, name in ipairs({"Left Arm", "Right Arm"}) do
            local limb = health:FindFirstChild(name)
            local broken = limb and limb:FindFirstChild("Broken")
            if broken and broken.Value then span *= 1.15 end
        end
    end
    local currents = stats:FindFirstChild("Currents")
    local spd = currents and currents:FindFirstChild("RL_SPM")
    if spd and type(spd.Value) == "number" and spd.Value > 0 then span /= spd.Value end
    return span
end
rageProto.ReloadOpen = function(tool, _values, now)
    if (now - ragebotController.ReloadDone) < 0.6 then return end
    ragebotController.ReloadTool = tool
    ragebotController.ReloadSent = now
    ragebotController.ReloadAck = 0
    ragebotController.ReloadTick = rageProto.ClientTick()
    if rageReloadEvent then rageReloadEvent:FireServer(rageProto.SecurityCode(), rageReloadToken, tool, math.random(), nil) end
end
rageProto.Reload = function(tool)
    local now = os.clock()
    if (now - ragebotController.LastReload) < 0.1 then return end
    ragebotController.LastReload = now
    local info = rageProto.Info(tool)
    local values = tool:FindFirstChild("Values")
    if ragebotController.ReloadTool ~= tool then
        ragebotController.ReloadTool = nil; ragebotController.ReloadSent = 0
        ragebotController.ReloadTick = nil; ragebotController.ReloadAck = 0
    end
    if not ragebotController.ReloadTool then rageProto.ReloadOpen(tool, values, now); return end
    if ragebotController.ReloadAck == 0 then
        local marked = ragebotController.ReloadTick
        if marked ~= nil and rageProto.ClientTick() == marked then
            if (now - ragebotController.ReloadSent) < 1 then return end
        end
        ragebotController.ReloadAck = now
    end
    local serverAmmo   = values and values:FindFirstChild("SERVER_Ammo")
    local storedAmmo   = values and values:FindFirstChild("SERVER_StoredAmmo")
    local clientAmmo   = values and values:FindFirstChild("Ammo")
    local clientStored = values and values:FindFirstChild("StoredAmmo")
    local magSize      = (info and tonumber(info.MagSize)) or 0
    if info and info.ShellReload then
        local magNow = serverAmmo and serverAmmo.Value or 0
        if clientAmmo and clientAmmo.Value < magNow then magNow = clientAmmo.Value end
        local reserveNow = storedAmmo and storedAmmo.Value or 0
        if clientStored and clientStored.Value > reserveNow then reserveNow = clientStored.Value end
        if (magSize > 0 and magNow >= magSize) or reserveNow <= 0 then
            ragebotController.ReloadTool = nil; ragebotController.ReloadSent = 0
            ragebotController.ReloadTick = nil; ragebotController.ReloadAck = 0
            ragebotController.ReloadDone = now; return
        end
        if (now - ragebotController.LastShell) < ((info and tonumber(info.ShellTime)) or 0.4) then return end
        ragebotController.LastShell = now
        if rageReloadEvent then rageReloadEvent:FireServer(rageProto.SecurityCode(), rageProto.ShellToken, tool, nil, nil) end
        return
    end
    if ragebotFlags.reload_Mode == "Spam" then
        if (now - (ragebotController.SpamAt or 0)) < 0.1 then return end
        ragebotController.SpamAt = now
        if rageReloadEvent then rageReloadEvent:FireServer(rageProto.SecurityCode(), rageProto.ShellToken, tool, nil, nil) end
        return
    end
    if (now - ragebotController.ReloadAck) < rageProto.ReloadSpan(info) then return end
    ragebotController.ReloadTool = nil; ragebotController.ReloadSent = 0
    ragebotController.ReloadTick = nil; ragebotController.ReloadAck = 0
    ragebotController.ReloadDone = now
    if rageReloadEvent then rageReloadEvent:FireServer(rageProto.SecurityCode(), rageProto.ShellToken, tool, nil, nil) end
end

local function isRageDowned(player)
    local charStats = ragebotController:GetCharStats()
    if not charStats then
        if not ragebotController.CharStatsWarned then
            ragebotController.CharStatsWarned = true
            safeNotify("Rage Bot: CharStats not found, Downed check unavailable", 4)
        end
        return false
    end
    local stats = charStats:FindFirstChild(player.Name)
    local downed = stats and stats:FindFirstChild("Downed")
    return downed ~= nil and downed.Value == true
end
local function isValidRageTarget(player)
    if not player or player == lp2 then return false end
    local status = getPlayerStatus(player)
    if status == "Ignored" or status == "Friendly" then return false end
    if ragebotFlags.enemy_Only and status ~= "Enemy" then return false end
    if ragebotFlags.priority_Only and status ~= "Enemy" then return false end
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")

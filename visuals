function ragebotController:ApplyStickiness(targets)
    local sticky = self.StickyTarget
    if not sticky then return end
    local index
    for i, target in ipairs(targets) do
        if target.Player == sticky then index = i; break end
    end
    if not index then self.StickyTarget = nil; return end
    if not ragebotFlags.target_Sticky or index == 1 then return end
    local current, best = targets[index], targets[1]
    if best.Priority ~= current.Priority then return end
    local margin = math.clamp(tonumber(ragebotFlags.target_Switch_Margin) or 25, 0, 100) / 100
    if best.SelectionValue < current.SelectionValue * (1 - margin) then return end
    table.remove(targets, index); table.insert(targets, 1, current)
end


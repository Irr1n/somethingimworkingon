local function espGetHealthColor(cfg, pct)
    if pct > 0.5 then return cfg.HealthMid:Lerp(cfg.HealthHigh, (pct - 0.5) * 2) end
    return cfg.HealthLow:Lerp(cfg.HealthMid, pct * 2)
end
local function espGetArmorColor(cfg, pct)
    if pct > 0.5 then return cfg.ArmorMid:Lerp(cfg.ArmorHigh, (pct - 0.5) * 2) end

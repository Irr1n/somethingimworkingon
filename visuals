function ragebotController:Unload()
    if self.Unloaded then return end
    self.Unloaded = true
    self.ShotInProgress = false
    getgenv().drain_rage_shooting = false
    self.StickyTarget = nil
    ragebotFlags.enabled = false
    resetRageTargetCache()
    if self.FovConnection then self.FovConnection:Disconnect(); self.FovConnection = nil end
    if self.FovCircle then removeFovCircle(self.FovCircle); self.FovCircle = nil end
    if self.TargetLine then pcall(function() self.TargetLine:Remove() end); self.TargetLine = nil end
end


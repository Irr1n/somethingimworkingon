local pendingHits = {}
local function trackRageHit(player, character, humanoid, method, healthBefore)
    if not player or not humanoid or not healthBefore then return end
    table.insert(pendingHits, {
        Player = player, Character = character, Humanoid = humanoid,
        Method = method or "Direct", HealthBefore = healthBefore, Time = os.clock(),
    })
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        local now = os.clock()
        local toNotify, toRemove = {}, {}
        for i, hit in ipairs(pendingHits) do
            local hum = hit.Humanoid
            local valid = hum and hum.Parent and hit.Character and hit.Character.Parent
            if not valid then table.insert(toRemove, i)
            elseif hum.Health < hit.HealthBefore - 0.5 then
                local damage = math.floor(hit.HealthBefore - hum.Health + 0.5)
                if damage > 0 then
                    table.insert(toNotify, { Index = i, Damage = damage, Method = hit.Method, Name = hit.Player.Name, HealthBefore = hit.HealthBefore })
                end
            elseif (now - hit.Time) > 3 then table.insert(toRemove, i) end
        end
        for _, n in ipairs(toNotify) do
            safeNotify(string.format("[%s] нанес урон %s %d", n.Method, n.Name, n.Damage), 3)
            table.insert(toRemove, n.Index)
        end
        table.sort(toRemove, function(a, b) return a > b end)
        local removed = {}
        for _, idx in ipairs(toRemove) do
            if pendingHits[idx] and not removed[idx] then
                table.remove(pendingHits, idx); removed[idx] = true
            end
        end
    end
end)


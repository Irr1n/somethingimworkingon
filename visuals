local function getAimbotKeybind()
    local k = Library.Flags["AB_Key"]
    if k == nil then return Enum.UserInputType.MouseButton2 end
    if typeof(k) == "EnumItem" then return k end
    if type(k) == "string" then
        local ok, enum = pcall(function() return Enum.KeyCode[k] end)
        if ok and enum then return enum end
        local ok2, enum2 = pcall(function() return Enum.UserInputType[k] end)
        if ok2 and enum2 then return enum2 end
    end
    if typeof(k) == "userdata" and k.Name then
        local ok, enum = pcall(function() return Enum.KeyCode[k.Name] end)
        if ok and enum then return enum end
        local ok2, enum2 = pcall(function() return Enum.UserInputType[k.Name] end)
        if ok2 and enum2 then return enum2 end
    end
    return Enum.UserInputType.MouseButton2
end

local function isAimbotActive()
    if not Aimbot.Enabled then return false end
    if Aimbot.ActivationMode == "Always" then return true end
    if Aimbot.ActivationMode == "Hold" then return Aimbot._holding end
    if Aimbot.ActivationMode == "Toggle" then return Aimbot._toggled end
    return false
end

local function aimbotIsVisible(targetPart, targetChar)
    if not Aimbot.WallCheck then return true end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    aimbotRayParams.FilterDescendantsInstances = { LocalPlayer.Character }
    local dir = targetPart.Position - cam.CFrame.Position
    local result = workspace:Raycast(cam.CFrame.Position, dir, aimbotRayParams)
    if not result then return true end
    return result.Instance:IsDescendantOf(targetChar)
end

local function aimbotClosestPoint(part, fromPos)
    local cf = part.CFrame; local half = part.Size / 2
    local localFrom = cf:PointToObjectSpace(fromPos)
    return cf:PointToWorldSpace(Vector3.new(
        math.clamp(localFrom.X, -half.X, half.X),
        math.clamp(localFrom.Y, -half.Y, half.Y),
        math.clamp(localFrom.Z, -half.Z, half.Z)))
end

local function aimbotGetCandidateParts(char)
    local names
    if Aimbot.TargetPart == "Head" then
        names = { "Head" }
    elseif Aimbot.TargetPart == "Torso" then
        names = { "Torso", "UpperTorso", "HumanoidRootPart" }
    else
        names = { "Head", "Torso", "UpperTorso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
    end
    local parts = {}
    for _, name in ipairs(names) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then table.insert(parts, p) end
    end
    return parts
end

local function aimbotIsValidTarget(player)
    if not player or player == LocalPlayer then return false end
    if Aimbot.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
    if Aimbot.FriendCheck and aimbotIsFriend(player) then return false end
    local status = getPlayerStatus(player)
    if status == "Ignored" or status == "Friendly" then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end
    if Aimbot.IgnoreDowned and aimbotIsDowned(player) then return false end
    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then return false end
    if (hrp.Position - localHRP.Position).Magnitude > Aimbot.MaxDistance then return false end
    return true
end

local function aimbotFindBestTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local mousePos = getAimScreenPosition()
    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then return nil end

    local now = tick()
    if Aimbot._currentTarget and now < Aimbot._stickyUntil then
        local t = Aimbot._currentTarget
        local char = t.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and aimbotIsValidTarget(t) then
                local bestPart, bestScore = nil, math.huge
                for _, part in ipairs(aimbotGetCandidateParts(char)) do
                    if aimbotIsVisible(part, char) then
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 then
                            local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                            if d < bestScore and d <= Aimbot.FOV then bestScore = d; bestPart = part end
                        end
                    end
                end
                if bestPart then
                    Aimbot._currentPart = bestPart
                    return t
                end
            end
        end
    end

    local bestPlayer, bestPart, bestScore = nil, nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if aimbotIsValidTarget(player) then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                local nearestDist = math.huge
                local nearestPart = nil
                for _, part in ipairs(aimbotGetCandidateParts(char)) do
                    if aimbotIsVisible(part, char) then
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 then
                            local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                            if d <= Aimbot.FOV and d < nearestDist then
                                nearestDist = d; nearestPart = part
                                if d < 20 then break end
                            end
                        end
                    end
                end
                if nearestPart then
                    local score
                    if Aimbot.Priority == "Nearest" then score = (hrp.Position - localHRP.Position).Magnitude
                    elseif Aimbot.Priority == "Lowest HP" then score = hum.Health
                    else score = nearestDist end
                    if score < bestScore then
                        bestScore = score
                        bestPlayer = player
                        bestPart = nearestPart
                    end
                end
            end
        end
    end

    if bestPlayer then
        if bestPlayer ~= Aimbot._currentTarget then Aimbot._lastTargetChange = now end
        Aimbot._currentTarget = bestPlayer
        Aimbot._currentPart = bestPart
        Aimbot._targetLostAt = 0
        Aimbot._stickyUntil = now + Aimbot.StickyDuration
        return bestPlayer
    end
    return nil
end

local function aimbotLockOn()
    local target = Aimbot._currentTarget
    if not target or not target.Character then
        Aimbot._currentTarget = nil; Aimbot._currentPart = nil; return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        Aimbot._currentTarget = nil; Aimbot._currentPart = nil; return
    end
    local part = Aimbot._currentPart
    if not part or not part.Parent then
        local mousePos = getAimScreenPosition()
        for _, p in ipairs(aimbotGetCandidateParts(target.Character)) do
            if aimbotIsVisible(p, target.Character) then
                local sp, onScreen = cam:WorldToViewportPoint(p.Position)
                if onScreen and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                    if d <= Aimbot.FOV then part = p; break end
                end
            end
        end
    end
    if not part then Aimbot._currentTarget = nil; Aimbot._currentPart = nil; return end
    local aimPos = aimbotClosestPoint(part, cam.CFrame.Position)
    if Aimbot.Prediction then
        local vel = part.AssemblyLinearVelocity or Vector3.zero
        aimPos = aimPos + vel * Aimbot.PredictionAmount
    end
    local lerpFactor = math.clamp(Aimbot.AimSpeed / 100, 0.01, 1)
    local desired = CFrame.new(cam.CFrame.Position, aimPos)
    cam.CFrame = cam.CFrame:Lerp(desired, lerpFactor)
end


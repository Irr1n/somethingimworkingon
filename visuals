    local TTexs = {
        ["Obelus"] = {Tex = "rbxassetid://2382169232", Len = 5, Mode = "Stretch"},
        ["Lightning"] = {Tex = "rbxassetid://7151778302", Len = 1, Mode = "Stretch"},
        ["DNA"] = {Tex = "rbxassetid://7071778278", Len = 12, Mode = "Wrap"},

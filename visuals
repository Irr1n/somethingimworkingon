return function(Library, VisualsTab)
    local Players = game:GetService("Players")
    local CoreGui = game:GetService("CoreGui")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local Workspace = game:GetService("Workspace")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local Lighting = game:GetService("Lighting")
    local HttpService = game:GetService("HttpService")
    local PhysicsService = game:GetService("PhysicsService")
    local localPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera

    -- ============================================
    -- 1. VISUAL GHOST
    -- ============================================
    local ghostMaterial = "SmoothPlastic"
    local ghostColor = Color3.fromRGB(200, 200, 200)
    local ghostTransparency = 0
    local ghostEnabled = false

    local ALLOWED_NAMES = {
        ["Head"] = true, ["Torso"] = true, ["Left Arm"] = true,
        ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true
    }

    local function createGhost(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return end
        local targetChar = targetPlayer.Character
        local ghost = Instance.new("Model")
        ghost.Name = targetChar.Name .. "_Ghost_R6_" .. os.time()
        ghost.Parent = Workspace

        local created = 0
        for _, originalPart in ipairs(targetChar:GetDescendants()) do
            if originalPart:IsA("BasePart") and ALLOWED_NAMES[originalPart.Name] then
                local newPart = Instance.new("Part")
                newPart.Name = originalPart.Name
                newPart.Size = originalPart.Size
                newPart.CFrame = originalPart.CFrame
                newPart.Material = Enum.Material[ghostMaterial] or Enum.Material.SmoothPlastic
                newPart.Color = ghostColor
                newPart.Transparency = ghostTransparency
                newPart.Anchored = true
                newPart.CanCollide = false
                newPart.CanTouch = false
                newPart.CanQuery = false
                newPart.Parent = ghost
                created = created + 1
            end
        end

        if created == 0 then ghost:Destroy(); return end

        local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Linear)
        local target = { Transparency = 1 }
        for _, part in ipairs(ghost:GetDescendants()) do
            if part:IsA("BasePart") then TweenService:Create(part, tweenInfo, target):Play() end
        end

        task.delay(1.5, function() if ghost and ghost.Parent then ghost:Destroy() end end)
    end

    local function setupHitmarkerListener(tool)
        if not tool or not tool:IsA("Tool") then return end
        local hitmarker = tool:FindFirstChild("Hitmarker")
        if hitmarker and hitmarker:IsA("BindableEvent") then
            hitmarker.Event:Connect(function(targetPart)
                if targetPart and targetPart.Parent and ghostEnabled then
                    local victim = Players:GetPlayerFromCharacter(targetPart.Parent)
                    if victim then createGhost(victim) end
                end
            end)
        end
    end

    local function onCharacterAdded(char)
        task.wait(0.5)
        for _, tool in ipairs(char:GetChildren()) do if tool:IsA("Tool") then setupHitmarkerListener(tool) end end
        char.ChildAdded:Connect(function(child) if child:IsA("Tool") then setupHitmarkerListener(child) end end)
    end

    local function enableGhost()
        ghostEnabled = true
        if localPlayer.Character then onCharacterAdded(localPlayer.Character) end
        localPlayer.CharacterAdded:Connect(onCharacterAdded)

        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do if tool:IsA("Tool") then setupHitmarkerListener(tool) end end
            backpack.ChildAdded:Connect(function(child) if child:IsA("Tool") then setupHitmarkerListener(child) end end)
        end
    end

    local function disableGhost()
        ghostEnabled = false
        for _, model in ipairs(Workspace:GetChildren()) do
            if model.Name:find("_Ghost_R6_") then model:Destroy() end
        end
    end

    -- ============================================
    -- 2. NO SCOPE GLINT
    -- ============================================
    local NoScopeGlint = { Enabled = false, Conn = nil, Hidden = {} }

    local function nsg_hide_glints(char)
        if not char then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end
        for _, obj in next, tool:GetDescendants() do
            if obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or obj:IsA("PointLight") then
                if NoScopeGlint.Hidden[obj] == nil then
                    NoScopeGlint.Hidden[obj] = obj.Enabled
                    obj.Enabled = false
                end
            end
        end
    end

    local function nsg_restore_glints()
        for obj, wasEnabled in next, NoScopeGlint.Hidden do pcall(function() obj.Enabled = wasEnabled end) end
        NoScopeGlint.Hidden = {}
    end

    local function nsg_enable()
        if NoScopeGlint.Enabled then return end
        NoScopeGlint.Enabled = true
        NoScopeGlint.Hidden = {}
        local function applyToChar(char)
            if not char then return end
            nsg_hide_glints(char)
            char.ChildAdded:Connect(function(child) if not NoScopeGlint.Enabled then return end; if child:IsA("Tool") then task.wait(0.1); nsg_hide_glints(char) end end)
            char.DescendantAdded:Connect(function(obj)
                if not NoScopeGlint.Enabled then return end
                if obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or obj:IsA("PointLight") then
                    task.wait()
                    if NoScopeGlint.Hidden[obj] == nil then NoScopeGlint.Hidden[obj] = obj.Enabled; obj.Enabled = false end
                end
            end)
        end
        applyToChar(localPlayer.Character)
        NoScopeGlint.Conn = localPlayer.CharacterAdded:Connect(function(char) if not NoScopeGlint.Enabled then return end; NoScopeGlint.Hidden = {}; task.wait(1); applyToChar(char) end)
    end

    local function nsg_disable()
        if not NoScopeGlint.Enabled then return end
        NoScopeGlint.Enabled = false
        if NoScopeGlint.Conn then NoScopeGlint.Conn:Disconnect(); NoScopeGlint.Conn = nil end
        nsg_restore_glints()
    end

    -- ============================================
    -- 3. CUSTOM MAX ZOOM
    -- ============================================
    local CustomMaxZoom = { Enabled = false, Value = 128, Conn = nil }
    local function apply_custom_max_zoom()
        if CustomMaxZoom.Enabled then
            if not CustomMaxZoom.Conn then
                CustomMaxZoom.Conn = RunService.Heartbeat:Connect(function()
                    if localPlayer.CameraMaxZoomDistance ~= CustomMaxZoom.Value then localPlayer.CameraMaxZoomDistance = CustomMaxZoom.Value end
                end)
            end
        else
            if CustomMaxZoom.Conn then CustomMaxZoom.Conn:Disconnect(); CustomMaxZoom.Conn = nil end
        end
    end

    -- ============================================
    -- 4. NO CAMERA BOBBING
    -- ============================================
    local NoCamBob = { Enabled = false, Conn = nil, ConfigTable = nil, Scanned = false }

    local function ncb_scan()
        if NoCamBob.Scanned then return end
        NoCamBob.Scanned = true
        if not getgc or not isreadonly then return end
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" and not isreadonly(v) then
                if rawget(v, "CameraBobbing") ~= nil or rawget(v, "Bobbing") ~= nil then
                    NoCamBob.ConfigTable = v
                    break
                end
            end
        end
    end

    local function apply_nocambob()
        ncb_scan()
        local t = NoCamBob.ConfigTable
        if not t then return end
        if rawget(t, "CameraBobbing") ~= nil then t.CameraBobbing = false end
        if rawget(t, "Bobbing") ~= nil then t.Bobbing = false end
        if NoCamBob.Conn then NoCamBob.Conn:Disconnect(); NoCamBob.Conn = nil end
        NoCamBob.Conn = RunService.Heartbeat:Connect(function()
            if not NoCamBob.Enabled then return end
            if rawget(t, "CameraBobbing") ~= nil then t.CameraBobbing = false end
            if rawget(t, "Bobbing") ~= nil then t.Bobbing = false end
        end)
    end

    local function disable_nocambob()
        if NoCamBob.Conn then NoCamBob.Conn:Disconnect(); NoCamBob.Conn = nil end
    end

    -- ============================================
    -- 5. CRIMV3 LIGHTING
    -- ============================================
    local savedLighting = {}
    local function applyCrimV3(state)
        if state then
            savedLighting.LightingStyle = Lighting.LightingStyle
            savedLighting.Technology = Lighting.Technology
            savedLighting.ExposureCompensation = Lighting.ExposureCompensation
            savedLighting.ShadowSoftness = Lighting.ShadowSoftness
            pcall(function() Lighting.LightingStyle = Enum.LightingStyle.Realistic end)
            pcall(function() Lighting.Technology = Enum.Technology.Future end)
            pcall(function() Lighting.ExposureCompensation = -0.2 end)
            pcall(function() Lighting.ShadowSoftness = 0 end)
        else
            if savedLighting.LightingStyle then pcall(function() Lighting.LightingStyle = savedLighting.LightingStyle end) end
            if savedLighting.Technology then pcall(function() Lighting.Technology = savedLighting.Technology end) end
            if savedLighting.ExposureCompensation then pcall(function() Lighting.ExposureCompensation = savedLighting.ExposureCompensation end) end
            if savedLighting.ShadowSoftness then pcall(function() Lighting.ShadowSoftness = savedLighting.ShadowSoftness end) end
            savedLighting = {}
        end
    end

    -- ============================================
    -- 6. DAMAGE NUMBERS & EFFECTS
    -- ============================================
    local Dmg = {
        damageEnabled = false, damageColor = Color3.fromRGB(255, 50, 50), damageSize = 30, damageLifetime = 1.5, damageUpDistance = 4,
        killFlashEnabled = false, killFlashColor = Color3.fromRGB(0, 0, 255), killFlashDuration = 0.1,
        explosionDeathEnabled = false, flingDeathEnabled = false, flingStrength = 100,
        deathGhostEnabled = false, deathGhostFadeTime = 1.0, deathGhostRiseHeight = 7.9, playDeathGhostSound = true,
        hitSoundsEnabled = false, hitSoundId = "135478009117226", headshotSoundId = "93203491784570", deathSoundId = "137176923000279"
    }

    local killFlashGui, killFlashFrame, killFlashTween = nil, nil, nil
    local monitoringActive = false
    local healthCache, monitoredPlayers, damageListeners, monitoringConnections, lastHitTime, deathProcessed = {}, {}, {}, {}, {}, {}

    local function getPlayerFromPart(part)
        local current = part
        while current do
            if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then return Players:GetPlayerFromCharacter(current) end
            current = current.Parent
        end
        return nil
    end

    local function playSound(soundId, volume)
        if not soundId or soundId == "" then return end
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://" .. soundId
        sound.Volume = volume or 1
        sound.Parent = Workspace
        sound:Play()
        sound.Ended:Connect(function() sound:Destroy() end)
        task.delay(10, function() if sound and sound.Parent then sound:Destroy() end end)
    end

    local function showDamageNumber(player, damage)
        if not Dmg.damageEnabled or not player or not player.Character then return end
        local head = player.Character:FindFirstChild("Head")
        if not head then return end
        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 100, 0, 50)
        billboard.Adornee = head
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = "-" .. tostring(math.floor(damage))
        label.TextColor3 = Dmg.damageColor
        label.TextSize = Dmg.damageSize
        label.Font = Enum.Font.GothamBold
        label.TextStrokeTransparency = 0.3
        label.Parent = billboard
        local tweenInfo = TweenInfo.new(Dmg.damageLifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(billboard, tweenInfo, {StudsOffset = Vector3.new(0, Dmg.damageUpDistance, 0)}):Play()
        TweenService:Create(label, tweenInfo, {TextTransparency = 1}):Play()
        task.delay(Dmg.damageLifetime + 0.1, function() if billboard.Parent then billboard:Destroy() end end)
    end

    local function triggerKillFlash()
        if not Dmg.killFlashEnabled then return end
        if not killFlashGui then
            killFlashGui = Instance.new("ScreenGui", CoreGui)
            killFlashFrame = Instance.new("Frame", killFlashGui)
            killFlashFrame.Size = UDim2.new(1, 0, 1, 0)
            killFlashFrame.BackgroundTransparency = 1
            killFlashFrame.BorderSizePixel = 0
        end
        if killFlashTween then killFlashTween:Cancel() end
        killFlashFrame.BackgroundColor3 = Dmg.killFlashColor
        killFlashFrame.BackgroundTransparency = 0.5
        killFlashTween = TweenService:Create(killFlashFrame, TweenInfo.new(Dmg.killFlashDuration, Enum.EasingStyle.Linear), {BackgroundTransparency = 1})
        killFlashTween:Play()
    end

    local function triggerExplosionDeath(player)
        if not Dmg.explosionDeathEnabled or not player.Character then return end
        local torso = player.Character:FindFirstChild("Torso")
        if torso then
            local explosion = Instance.new("Explosion")
            explosion.Position = torso.Position
            explosion.BlastRadius = 4
            explosion.BlastPressure = 1000
            explosion.Parent = Workspace
        end
    end

    local function triggerFlingDeath(player)
        if not Dmg.flingDeathEnabled or not player.Character then return end
        local myChar = localPlayer.Character
        local myPos = myChar and myChar:FindFirstChild("Torso") and myChar.Torso.Position or Vector3.new(0,0,0)
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") and part:CanSetNetworkOwnership() then
                local dir = (part.Position - myPos).Unit
                part.AssemblyLinearVelocity = Vector3.new(dir.X, dir.Y + 0.8, dir.Z).Unit * Dmg.flingStrength
                part.AssemblyAngularVelocity = Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20))
            end
        end
    end

    local function triggerDeathGhost(player)
        if not Dmg.deathGhostEnabled or not player.Character then return end
        task.wait(0.15)
        local char = player.Character
        if Dmg.playDeathGhostSound then playSound("125610525645835") end
        local parts = {}
        for _, obj in ipairs(char:GetDescendants()) do if obj:IsA("BasePart") then table.insert(parts, obj) end end
        if #parts == 0 then char:Destroy(); return end
        for _, obj in ipairs(char:GetChildren()) do if not obj:IsA("BasePart") then obj:Destroy() end end
        for _, part in ipairs(parts) do
            part.Color = Color3.new(0, 0, 0)
            part.Material = Enum.Material.SmoothPlastic
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
        end
        local riseVector = Vector3.new(0, Dmg.deathGhostRiseHeight, 0)
        local tweenInfo = TweenInfo.new(Dmg.deathGhostFadeTime, Enum.EasingStyle.Linear)
        for _, part in ipairs(parts) do TweenService:Create(part, tweenInfo, { Position = part.Position + riseVector, Transparency = 1 }):Play() end
        task.delay(Dmg.deathGhostFadeTime + 0.1, function() if char.Parent then char:Destroy() end end)
    end

    local function onHitmarker(targetPart)
        if not targetPart then return end
        local victim = getPlayerFromPart(targetPart)
        if not victim or victim == localPlayer then return end
        if Dmg.hitSoundsEnabled then
            local now = os.clock()
            local last = lastHitTime[victim] or 0
            if now - last > 0.05 then
                lastHitTime[victim] = now
                if targetPart.Name == "Head" then playSound(Dmg.headshotSoundId) else playSound(Dmg.hitSoundId) end
            end
        end
        monitoredPlayers[victim] = true
        local humanoid = victim.Character and victim.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then healthCache[victim] = humanoid.Health end
    end

    local function setupHitmarkerForTool(tool)
        if not tool or not tool:IsA("Tool") or damageListeners[tool] then return end
        local hitmarker = tool:FindFirstChild("Hitmarker")
        if not hitmarker or not hitmarker:IsA("BindableEvent") then return end
        damageListeners[tool] = true
        hitmarker.Event:Connect(onHitmarker)
    end

    local function scanToolsAndSubscribe()
        local char = localPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do if tool:IsA("Tool") then setupHitmarkerForTool(tool) end end
            char.ChildAdded:Connect(function(child) if child:IsA("Tool") then task.wait(0.1); setupHitmarkerForTool(child) end end)
        end
        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do if tool:IsA("Tool") then setupHitmarkerForTool(tool) end end
            backpack.ChildAdded:Connect(function(child) if child:IsA("Tool") then task.wait(0.1); setupHitmarkerForTool(child) end end)
        end
    end

    local function healthMonitor()
        if not monitoringActive then return end
        for _, player in ipairs(Players:GetPlayers()) do
            if player == localPlayer then continue end
            local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if not humanoid then healthCache[player] = nil; monitoredPlayers[player] = nil; deathProcessed[player] = nil; continue end
            local currentHealth = humanoid.Health
            local prevHealth = healthCache[player] or currentHealth
            if currentHealth < prevHealth and monitoredPlayers[player] then
                local damageDealt = prevHealth - currentHealth
                if damageDealt > 0 then showDamageNumber(player, damageDealt) end
                if currentHealth <= 0 and not deathProcessed[player] then
                    deathProcessed[player] = true
                    triggerKillFlash()
                    triggerExplosionDeath(player)
                    triggerFlingDeath(player)
                    triggerDeathGhost(player)
                    if Dmg.hitSoundsEnabled and Dmg.deathSoundId ~= "" then playSound(Dmg.deathSoundId) end
                end
                monitoredPlayers[player] = nil
            end
            healthCache[player] = currentHealth
        end
    end

    local function updateMonitoringState()
        if Dmg.damageEnabled or Dmg.killFlashEnabled or Dmg.explosionDeathEnabled or Dmg.flingDeathEnabled or Dmg.deathGhostEnabled or Dmg.hitSoundsEnabled then
            if not monitoringActive then
                monitoringActive = true
                scanToolsAndSubscribe()
                table.insert(monitoringConnections, RunService.Heartbeat:Connect(healthMonitor))
                table.insert(monitoringConnections, localPlayer.CharacterAdded:Connect(function() task.wait(0.5); scanToolsAndSubscribe() end))
                table.insert(monitoringConnections, localPlayer.CharacterRemoving:Connect(function() healthCache = {}; monitoredPlayers = {}; deathProcessed = {} end))
            end
        else
            if monitoringActive then
                monitoringActive = false
                for _, conn in ipairs(monitoringConnections) do conn:Disconnect() end
                monitoringConnections, healthCache, monitoredPlayers, deathProcessed, damageListeners = {}, {}, {}, {}, {}
            end
        end
    end

    -- ============================================
    -- 7. GRENADE TRAJECTORY
    -- ============================================
    local GT_CONFIG = {
        DEFAULT_THROW_SPEED = 150, EFFECTIVE_GRAVITY_SCALE = 0.55, DEFAULT_FUSE_TIME = 2.5, MAX_PREDICT_TIME = 6, UNTIL_SLOW_MAX_TIME = 8,
        SIMULATION_DT = 1 / 90, MAX_BOUNCES = 6, MAX_POINTS = 220, MIN_SPEED = 1.25,
        BASE_MIN_RESTITUTION = 0.012, BASE_MAX_RESTITUTION = 0.24, BASE_MIN_TANGENT_DAMPING = 0.45, BASE_MAX_TANGENT_DAMPING = 0.92,
        LOW_SPEED_RESTITUTION_CUTOFF = 22, LOW_SPEED_RESTITUTION_MULT = 0.35, THROW_DELAY_SAFETY = 0.55, PREVIEW_UPDATE_INTERVAL = 1 / 30,
        PREVIEW_COLOR = Color3.fromRGB(255, 60, 60), PREVIEW_TRANSPARENCY = 0.15, PREVIEW_THICKNESS = 0.11,
        FIRST_PERSON_START_OFFSET = 0.35, CAMERA_NEAR_CLIP_DISTANCE = 1.4, LIVE_COLOR = Color3.fromRGB(255, 170, 120),
        LIVE_TRANSPARENCY = 0.2, LIVE_THICKNESS = 0.1, LIVE_SAMPLE_DT = 1 / 60, LIVE_TTL = 0.55, MAX_LIVE_TIME = 6, FLIGHT_MIN_START_SPEED = 8,
    }

    local rootParent = Workspace:FindFirstChild("Debris") or Workspace
    local function randomName(prefix) return prefix .. tostring(math.random(100000, 999999)) end
    local previewParent, liveParent = rootParent, rootParent

    local function getHead(char) return char and char:FindFirstChild("Head") end
    local function getAimPoint()
        local mouse = localPlayer:GetMouse()
        if mouse and mouse.Hit then return mouse.Hit.Position end
        local camera = Workspace.CurrentCamera
        if camera then return camera.CFrame.Position + camera.CFrame.LookVector * 500 end
        return Vector3.zero
    end

    local function isThrowableTool(tool)
        if not tool or not tool:IsA("Tool") then return false end
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChild("RightGrip")
        if not handle then return false end
        return tool:FindFirstChild("AnimsFolder") ~= nil
    end

    local function getGripPart(tool)
        local handle = tool:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then return handle end
        local rightGrip = tool:FindFirstChild("RightGrip")
        if rightGrip and rightGrip:IsA("BasePart") then return rightGrip end
        return nil
    end

    local toolStates, previewSegments, activeFlights, activeByPart = {}, {}, {}, {}
    local previewTool, lastPreviewTick = nil, 0
    local GrenadeTrajectoryEnabled, GrenadeTrajectoryConn = false, nil

    local function makeLineSegment(parent, color, transparency)
        local p = Instance.new("Part")
        p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
        p.Material = Enum.Material.Neon; p.Color = color; p.Transparency = transparency
        p.Size = Vector3.new(0.08, 0.08, 0.08)
        p.Parent = parent
        return p
    end

    local function placeSegment(part, p0, p1, thickness, color, transparency)
        local delta = p1 - p0
        local len = delta.Magnitude
        if len < 0.001 then part.Transparency = 1; return end
        part.Color = color; part.Transparency = transparency
        part.Size = Vector3.new(thickness, thickness, len)
        part.CFrame = CFrame.lookAt((p0 + p1) * 0.5, p1)
    end

    local function renderPath(points, pool, parent, color, transparency, thickness)
        local needed = math.max(0, #points - 1)
        for i = 1, needed do
            local seg = pool[i]
            if not seg then seg = makeLineSegment(parent, color, transparency); pool[i] = seg
            elseif seg.Parent ~= parent then seg.Parent = parent end
            placeSegment(seg, points[i], points[i+1], thickness, color, transparency)
        end
        for i = needed + 1, #pool do if pool[i] then pool[i].Parent = nil end end
    end

    local function simulateTrajectory(tool, state, nowTick)
        local head = getHead(localPlayer.Character)
        if not head then return {} end
        local startPos = head.Position
        local direction = (getAimPoint() - startPos).Unit
        local speed = GT_CONFIG.DEFAULT_THROW_SPEED
        local gravity = Vector3.new(0, -Workspace.Gravity * GT_CONFIG.EFFECTIVE_GRAVITY_SCALE, 0)
        local points = {startPos}
        local pos = startPos
        local vel = direction * speed
        local el = 0
        local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {localPlayer.Character, tool}

        while el < GT_CONFIG.MAX_PREDICT_TIME and #points < GT_CONFIG.MAX_POINTS do
            local step = GT_CONFIG.SIMULATION_DT
            local disp = (vel * step) + (0.5 * gravity * step * step)
            local hit = Workspace:Raycast(pos, disp, params)
            if hit then
                table.insert(points, hit.Position)
                break
            else
                pos = pos + disp
                vel = vel + gravity * step
                table.insert(points, pos)
            end
            el = el + step
        end
        return points
    end

    local function startGrenadeTrajectory()
        if GrenadeTrajectoryConn then return end
        GrenadeTrajectoryConn = RunService.RenderStepped:Connect(function()
            if not GrenadeTrajectoryEnabled then return end
            local nowTick = os.clock()
            local char = localPlayer.Character
            local equipped = nil
            if char then for _, t in ipairs(char:GetChildren()) do if isThrowableTool(t) then equipped = t; break end end end
            
            if equipped ~= previewTool then previewTool = equipped; lastPreviewTick = 0 end
            if previewTool and (nowTick - lastPreviewTick >= GT_CONFIG.PREVIEW_UPDATE_INTERVAL) then
                local state = toolStates[previewTool] or {}
                local points = simulateTrajectory(previewTool, state, nowTick)
                renderPath(points, previewSegments, previewParent, GT_CONFIG.PREVIEW_COLOR, GT_CONFIG.PREVIEW_TRANSPARENCY, GT_CONFIG.PREVIEW_THICKNESS)
                lastPreviewTick = nowTick
            elseif not previewTool then
                renderPath({}, previewSegments, previewParent, GT_CONFIG.PREVIEW_COLOR, GT_CONFIG.PREVIEW_TRANSPARENCY, GT_CONFIG.PREVIEW_THICKNESS)
            end
        end)
    end


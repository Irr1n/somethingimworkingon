-- =====================================================
-- ADONIS BYPASS
-- =====================================================
local function runAdonisBypass()
    if not (getreg and getgc and isfunctionhooked) then return false, "executor lacks required APIs" end
    pcall(function()
        for _, thread in getreg() do
            if typeof(thread) ~= "thread" then continue end
            local ok, src = pcall(debug.info, thread, 1, "s")
            if ok and src and (src:match(".Core.Anti") or src:match(".Plugins.Anti_Cheat")) then
                pcall(coroutine.close, thread)
            end
        end
    end)
    local adonisTables = {}
    pcall(function()
        if filtergc then
            local candidates = filtergc("table", { Keys = { "Detected", "RLocked" } }, false)
            for _, t in candidates do
                if typeof(rawget(t, "Detected")) == "function" then table.insert(adonisTables, t) end
            end
        else
            for _, t in getgc(true) do
                if typeof(t) == "table" and typeof(rawget(t, "Detected")) == "function" and rawget(t, "RLocked") then
                    table.insert(adonisTables, t)
                end
            end
        end
    end)
    local hooked = 0
    for _, tbl in ipairs(adonisTables) do
        pcall(function()
            for _, fn in pairs(tbl) do
                if typeof(fn) == "function" and not isfunctionhooked(fn) then
                    hookfunction(fn, function() coroutine.yield(); return task.wait(9e9) end)
                    hooked += 1
                end
            end
        end)
    end
    return hooked > 0, string.format("%d fns hooked / %d tables", hooked, #adonisTables)
end


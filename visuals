        ["Taser"] = {Tex = "rbxassetid://446111271", Len = 8, Mode = "Stretch"},
        ["Edge"] = {Tex = "rbxassetid://9149045341", Len = 6, Mode = "Stretch"},
        ["Energy"] = {Tex = "rbxassetid://6091341618", Len = 10, Mode = "Wrap"},
    }

    local function crBeam(sPos, ePos, col)
        if not BB.On or not sPos or not ePos then return nil end
        local bm, a0, a1 = Instance.new("Beam"), Instance.new("Attachment"), Instance.new("Attachment")
        local par = Workspace:FindFirstChild("Terrain") or Workspace
        a0.Position = sPos; a0.Parent = par; a1.Position = ePos; a1.Parent = par
        bm.Attachment0 = a0; bm.Attachment1 = a1
        bm.Color = ColorSequence.new(col)
        local tData = TTexs[BB.CurTex] or TTexs["DNA"]
        bm.Width0 = BB.Thick; bm.Width1 = BB.Thick * 0.5
        bm.Texture = tData.Tex; bm.TextureLength = tData.Len
        bm.TextureMode = Enum.TextureMode[tData.Mode] or Enum.TextureMode.Wrap
        bm.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, BB.Trans * 0.5), NumberSequenceKeypoint.new(0.5, BB.Trans), NumberSequenceKeypoint.new(1, 1)})
        bm.FaceCamera = true; bm.LightEmission = 0.5; bm.Parent = par
        local id = #BB.Active + 1; BB.Active[id] = {Beam = bm, Atts = {a0, a1}, Created = os.clock(), Type = "Beam"}
    end

    local function crPart(sPos, ePos, col)
        local dist = (sPos - ePos).Magnitude
        local par = Instance.new("Part")
        par.Anchored = true; par.CanCollide = false; par.CastShadow = false; par.Massless = true
        par.Material = Enum.Material[BB.Mat] or Enum.Material.ForceField
        par.Color = col; par.Transparency = BB.Trans
        local th = BB.Thick or 0.1
        par.Size = Vector3.new(th, th, dist)
        par.CFrame = CFrame.lookAt(sPos, ePos) * CFrame.new(0, 0, -dist / 2)
        par.Parent = Workspace
        local id = #BB.Active + 1; BB.Active[id] = {Part = par, Created = os.clock(), Type = "Part"}
    end

    local function crLine(sPos, ePos, col)
        if not Drawing then return end
        local line = Drawing.new("Line")
        line.Visible = true; line.From = Vector2.new(sPos.X, sPos.Y); line.To = Vector2.new(ePos.X, ePos.Y)
        line.Color = col; line.Thickness = math.floor(BB.Thick * 10); line.Transparency = BB.Trans
        local id = #BB.Active + 1; BB.Active[id] = {Line = line, Created = os.clock(), Type = "Line"}
    end

    local function setupBB()
        local ev2 = ReplicatedStorage:FindFirstChild("Events2")
        if ev2 and ev2:FindFirstChild("Visualize") then
            table.insert(BB.Conns, ev2.Visualize.Event:Connect(function(_, _, _, gun, _, sPos, bps)
                if not BB.On or not bps then return end
                for _, bDir in pairs(bps) do
                    local hit = Workspace:Raycast(sPos, bDir * 1000)
                    local ePos = hit and hit.Position or sPos + (bDir * 500)
                    if BB.Type == "Beam" then crBeam(sPos, ePos, BB.Col) elseif BB.Type == "Part" then crPart(sPos, ePos, BB.Col) else crLine(sPos, ePos, BB.Col) end
                end
            end))
        end
    end

    local function toggleBB(state)
        BB.On = state
        if state then
            setupBB()
            table.insert(BB.Conns, RunService.RenderStepped:Connect(function()
                for id, t in pairs(BB.Active) do
                    local el = os.clock() - t.Created
                    local maxLife = BB.SmoothFade and (BB.Life + BB.FadeSpeed) or BB.Life
                    if el > maxLife then
                        if t.Beam then t.Beam:Destroy() elseif t.Line then t.Line:Remove() elseif t.Part then t.Part:Destroy() end
                        if t.Atts then for _, a in ipairs(t.Atts) do if a.Parent then a:Destroy() end end end
                        BB.Active[id] = nil
                        continue
                    end
                end
            end))
        else
            for _, c in pairs(BB.Conns) do c:Disconnect() end
            BB.Conns = {}
            for id, t in pairs(BB.Active) do
                if t.Beam then t.Beam:Destroy() elseif t.Line then t.Line:Remove() elseif t.Part then t.Part:Destroy() end
                if t.Atts then for _, a in ipairs(t.Atts) do if a.Parent then a:Destroy() end end end
            end
            BB.Active = {}
        end
    end


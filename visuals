    if not barriersFolder then return end
    for _, part in ipairs(barriersFolder:GetDescendants()) do
        if part:IsA("BasePart") then
            if noBarriers.Originals[part] == nil then noBarriers.Originals[part] = part.CanTouch end
            part.CanTouch = false
        end
    end
end
local autoRefillAmmo = { Enabled = false, Conn = nil, LastRefill = 0 }
local function enableAutoRefillAmmo()
    autoRefillAmmo.Enabled = true
    if autoRefillAmmo.Conn then autoRefillAmmo.Conn:Disconnect(); autoRefillAmmo.Conn = nil end
    autoRefillAmmo.Conn = RunService.Heartbeat:Connect(function()
        if not autoRefillAmmo.Enabled then return end
        if tick() - autoRefillAmmo.LastRefill < 0.5 then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end
        local weaponName = tool.Name
        local openEvent = ReplicatedStorage.Events:FindFirstChild("BYZERSPROTEC")
        local buyEvent = ReplicatedStorage.Events:FindFirstChild("SSHPRMTE1")
        if not openEvent or not buyEvent then return end
        local shopz = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Shopz")
        if not shopz then return end
        local closestStore, closestDist = nil, 15
        for _, storeFolder in ipairs(shopz:GetChildren()) do
            local mainPart = storeFolder:FindFirstChild("MainPart")
            if mainPart then
                local dist = (hrp.Position - mainPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    local storeType = "IllegalStore"
                    if storeFolder.Name:lower():find("armor") or storeFolder.Name:lower():find("legal") then storeType = "LegalStore" end
                    closestStore = { name = storeType, main_part = mainPart }
                end
            end
        end
        if closestStore then
            pcall(function()
                openEvent:FireServer()
                buyEvent:InvokeServer(closestStore.name, "Guns", weaponName, closestStore.main_part, "ResupplyAmmo", true)
                autoRefillAmmo.LastRefill = tick()
                task.wait(0.1)
                local backpackWeapon = LocalPlayer.Backpack:FindFirstChild(weaponName)
                if backpackWeapon and char:FindFirstChild("Humanoid") then char.Humanoid:EquipTool(backpackWeapon) end
            end)
        end
    end)
end
local function disableAutoRefillAmmo()
    autoRefillAmmo.Enabled = false
    if autoRefillAmmo.Conn then autoRefillAmmo.Conn:Disconnect(); autoRefillAmmo.Conn = nil end
end
local autoClaimAllowance = { Enabled = false, Conn = nil, LastClaim = 0, Busy = false }
local function findNearestAtm(maxDistance)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local map = Workspace:FindFirstChild("Map")
    local atmFolder = map and map:FindFirstChild("ATMz")
    if not atmFolder then return nil end
    local closestPart, closestDist = nil, maxDistance
    for _, atm in ipairs(atmFolder:GetChildren()) do
        local mainPart = atm:FindFirstChild("MainPart")
        if mainPart then
            local distance = (hrp.Position - mainPart.Position).Magnitude
            if distance < closestDist then closestDist = distance; closestPart = mainPart end
        end
    end
    return closestPart
end
local function enableAutoClaimAllowance()
    autoClaimAllowance.Enabled = true
    if autoClaimAllowance.Conn then autoClaimAllowance.Conn:Disconnect(); autoClaimAllowance.Conn = nil end
    autoClaimAllowance.LastClaim = 0; autoClaimAllowance.Busy = false
    autoClaimAllowance.Conn = RunService.Heartbeat:Connect(function()
        if not autoClaimAllowance.Enabled or autoClaimAllowance.Busy then return end
        if tick() - autoClaimAllowance.LastClaim < 5 then return end
        local data = ReplicatedStorage:FindFirstChild("PlayerbaseData2")
        local playerData = data and data:FindFirstChild(LocalPlayer.Name)
        local nextAllowance = playerData and playerData:FindFirstChild("NextAllowance")
        if not nextAllowance or nextAllowance.Value ~= 0 then return end
        local claimEvent = ReplicatedStorage.Events:FindFirstChild("CLMZALOW")
        if not claimEvent then return end
        local atmPart = findNearestAtm(math.huge)
        if not atmPart then return end
        autoClaimAllowance.LastClaim = tick()
        autoClaimAllowance.Busy = true
        pcall(function() claimEvent:InvokeServer(atmPart) end)
        autoClaimAllowance.Busy = false
        autoClaimAllowance.LastClaim = tick()
    end)
end
local function disableAutoClaimAllowance()
    autoClaimAllowance.Enabled = false
    if autoClaimAllowance.Conn then autoClaimAllowance.Conn:Disconnect(); autoClaimAllowance.Conn = nil end
end


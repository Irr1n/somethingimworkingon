            local isJumping = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
            local isSwimming = state == Enum.HumanoidStateType.Swimming
            if isJumping and cfg.FlagsJumping then table.insert(flagList, { "Jumping", cfg.FlagColorJumping })
            elseif isMoving and cfg.FlagsMoving then table.insert(flagList, { "Moving", cfg.FlagColorMoving })
            elseif isSwimming and cfg.FlagsSwimming then table.insert(flagList, { "Swimming", cfg.FlagColorSwimming })
            elseif cfg.FlagsIdle then table.insert(flagList, { "Idle", cfg.FlagColorIdle }) end
            if cfg.FlagsForceField and char:FindFirstChildOfClass("ForceField") then
                table.insert(flagList, { "FF", cfg.FlagColorForceField })
            end
            if cfg.FlagsDowned and espIsDowned(player) then
                table.insert(flagList, { "Downed", cfg.FlagColorDowned })
            end
            local isRight = cfg.FlagsPos == "Right"
            local fx = isRight and (boxRight + 4) or (boxLeft - 104)
            local fy = topY
            for i = 1, #o.FlagLabels do
                local fl = o.FlagLabels[i]
                if flagList[i] then
                    espSet(fl, "Text", flagList[i][1])
                    espSet(fl, "TextColor3", flagList[i][2])
                    espSet(fl, "TextSize", cfg.FlagsSize)
                    espSet(fl, "Position", UDim2.new(0, math.floor(fx), 0, math.floor(fy + (i - 1) * (cfg.FlagsSize + 1))))
                    espSet(fl, "TextXAlignment", isRight and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right)
                    espSet(fl, "Visible", true)
                else espSet(fl, "Visible", false) end
            end
        else for i = 1, #o.FlagLabels do espSet(o.FlagLabels[i], "Visible", false) end end
        if cfg.Tracers then
            local fromX, fromY
            if cfg.TracerFrom == "Top" then fromX, fromY = viewport.X / 2, 0
            elseif cfg.TracerFrom == "Middle" then fromX, fromY = viewport.X / 2, viewport.Y / 2
            else fromX, fromY = viewport.X / 2, viewport.Y end
            espDrawLine(o.Tracer, fromX, fromY, centerX, bottomY, cfg.TracerThickness)
            espSet(o.Tracer, "BackgroundColor3", isFriend and cfg.FriendsColor or cfg.TracerColor)
            espSet(o.Tracer, "Visible", true)
        else espSet(o.Tracer, "Visible", false) end
    end
    for player, _ in pairs(PlayerESP.Objects) do
        if not player.Parent or not player.Character then espDestroyObjects(player) end
    end
end
local function espStart()
    PlayerESP.Cfg.Enabled = true
    espEnsureGui()
    if not PlayerESP.RenderConn then
        PlayerESP.RenderConn = rs2.RenderStepped:Connect(function() pcall(espRender) end)
    end
end
local function espStop()
    PlayerESP.Cfg.Enabled = false
    if PlayerESP.RenderConn then PlayerESP.RenderConn:Disconnect(); PlayerESP.RenderConn = nil end
    for player, _ in pairs(PlayerESP.Objects) do espDestroyObjects(player) end
    for player, hl in pairs(PlayerESP.Highlights) do if hl then pcall(function() hl:Destroy() end) end end
    table.clear(PlayerESP.Highlights)
end

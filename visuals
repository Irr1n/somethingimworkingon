local function RefreshCustomThemes()
    local list = {"Default", "RAZEBALITI V1"}
    if listfiles then
        for _, file in pairs(listfiles(ThemeManager.Folder)) do
            local name = file:match("([^/\\]+)%.json$")
            if name then table.insert(list, name) end
        end
    end
    return list
end
local ThemePanel = ConfigsTab:CreatePanel("Theme Manager")
local function ApplyTheme(name)
    local themeData
    if ThemeManager.BuiltInThemes[name] then
        themeData = ThemeManager.BuiltInThemes[name]
    else
        local success, result = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(ThemeManager.Folder .. "/" .. name .. ".json"))
        end)
        if success and type(result) == "table" then
            themeData = {
                Accent = Color3.new(result.Accent.R, result.Accent.G, result.Accent.B),
                MainBg = Color3.new(result.MainBg.R, result.MainBg.G, result.MainBg.B),
                TopBarBg = Color3.new(result.TopBarBg.R, result.TopBarBg.G, result.TopBarBg.B),
                PanelBg = Color3.new(result.PanelBg.R, result.PanelBg.G, result.PanelBg.B),
                Border = Color3.new(result.Border.R, result.Border.G, result.Border.B),
                Text = Color3.new(result.Text.R, result.Text.G, result.Text.B)
            }
        end
    end
    if themeData then
        Library:SetTheme("Accent", themeData.Accent)
        Library:SetTheme("MainBg", themeData.MainBg)
        Library:SetTheme("TopBarBg", themeData.TopBarBg)
        Library:SetTheme("PanelBg", themeData.PanelBg)
        Library:SetTheme("Border", themeData.Border)
        Library:SetTheme("Text", themeData.Text)
        Library:Notify("Applied theme: " .. name, 3)
    else Library:Notify("Failed to load theme!", 3) end
end
